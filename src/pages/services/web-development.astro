---
import Layout from "../../layouts/Layout.astro";
import Header from "../../components/Header.astro";
import Footer from "../../components/Footer.astro";
import PageHeader from "../../components/PageHeader.astro";

const features = [
    {
        title: "Custom Solutions for Unique Businesses",
        description:
            "We understand that every business is different, and so are its digital needs. Our custom website development services ensure your site reflects your goals and brand identity.",
    },
    {
        title: "Responsive and User-Centric Designs",
        description:
            "From desktop to mobile devices, our websites provide seamless, engaging, and accessible user experiences that retain visitors and boost interaction.",
    },
    {
        title: "SEO-Optimized Development",
        description:
            "All our websites are designed with search engines in mind, ensuring better visibility and higher rankings with SEO-friendly website development techniques.",
    },
];

const services = [
    {
        title: "Custom Website Development",
        points: [
            "Unique Designs: Fully customized to align with your brand and goals.",
            "Advanced Features: Integration of e-commerce, booking systems, and more.",
            "Scalable Solutions: Websites built to grow alongside your business needs.",
        ],
    },
    {
        title: "Responsive Website Development",
        points: [
            "Mobile-Optimized Design: Prioritizing mobile users for better accessibility.",
            "Cross-Browser Compatibility: Ensuring consistent performance across popular browsers.",
            "Intuitive Navigation: Layouts designed for effortless browsing and user retention.",
        ],
    },
    {
        title: "E-Commerce Website Development",
        points: [
            "Custom E-Commerce Solutions: Tailored online stores for your unique audience.",
            "Payment Gateway Integration: Secure, seamless payment processes.",
            "Inventory Management: Easy-to-use interfaces for efficient product management.",
        ],
    },
    {
        title: "Website Maintenance and Support",
        points: [
            "Regular Updates: Stay ahead with the latest web technologies.",
            "Performance Enhancements: Continuous monitoring and optimization for speed and reliability.",
            "Security Checks: Advanced measures to protect your site against threats.",
        ],
    },
    {
        title: "Web Application Development",
        points: [
            "Custom Features: Applications designed to streamline business processes.",
            "Interactive Interfaces: Engaging designs for improved user interaction.",
            "Integration Services: Seamless transition and integration with your existing platforms.",
        ],
    },
];

const benefits = [
    "Stronger Online Presence: Build a website that resonates with your brand and attracts your target audience.",
    "Increased Engagement: Retain visitors with intuitive and responsive designs.",
    "Improved SEO Rankings: Gain higher visibility through optimized web development practices.",
    "Scalable Growth: Start small and expand your website’s functionalities as your business grows.",
];

const process = [
    {
        step: "01",
        title: "Understanding Your Needs",
        description:
            "We start by analyzing your goals, target audience, and unique business challenges.",
    },
    {
        step: "02",
        title: "Planning and Design",
        description:
            "Our team crafts a visually appealing, brand-focused design that connects with your audience.",
    },
    {
        step: "03",
        title: "Development and Testing",
        description:
            "Leveraging the latest technologies, we build your website and conduct rigorous testing to ensure flawless performance.",
    },
    {
        step: "04",
        title: "Launch and Optimization",
        description:
            "After deployment, we provide ongoing support, updates, and optimizations to ensure your site remains cutting-edge.",
    },
];
---

<Layout
    title="Web Development - Craft Presence"
    description="Establish Your Online Identity"
>
    <Header />
    <main>
        <PageHeader
            title="Web Development"
            subtitle="Services That Establish Your Online Identity"
        />

        <!-- Intro & Why Us -->
        <section class="py-24 bg-white reveal">
            <div class="container mx-auto px-6">
                <div class="max-w-4xl mx-auto text-center mb-16">
                    <p class="text-lg text-neutral-600 leading-relaxed mb-12">
                        At Craft Presence, we deliver premier web development
                        services designed to elevate your business and
                        strengthen your digital footprint. From custom website
                        development to responsive designs and advanced
                        functionalities, we bring your vision to life. Let us
                        create a website that not only showcases your brand but
                        also delivers exceptional value to your users while
                        adhering to SEO-friendly structures and responsive
                        website development practices.
                    </p>

                    <div class="grid md:grid-cols-3 gap-8 text-left">
                        {
                            features.map((feature) => (
                                <div class="p-6 bg-neutral-50 rounded-2xl border border-neutral-100">
                                    <h4 class="text-xl font-bold text-primary mb-3">
                                        {feature.title}
                                    </h4>
                                    <p class="text-neutral-600 text-sm">
                                        {feature.description}
                                    </p>
                                </div>
                            ))
                        }
                    </div>
                </div>
            </div>
        </section>

        <!-- Comprehensive Services -->
        <section class="py-24 bg-neutral-950 text-white reveal">
            <div class="container mx-auto px-6">
                <div class="text-center mb-16">
                    <h2
                        class="text-sm font-bold text-primary tracking-widest uppercase mb-3"
                    >
                        Our Services
                    </h2>
                    <h3 class="text-3xl md:text-4xl font-bold">
                        Comprehensive Web Development
                    </h3>
                </div>

                <div class="grid md:grid-cols-2 gap-8 max-w-5xl mx-auto">
                    {
                        services.map((service) => (
                            <div class="p-8 rounded-3xl bg-white/5 border border-white/5 hover:bg-white/10 transition-colors">
                                <h4 class="text-2xl font-bold text-white mb-6">
                                    {service.title}
                                </h4>
                                <ul class="space-y-3">
                                    {service.points.map((point) => (
                                        <li class="flex items-start gap-3 text-neutral-400">
                                            <svg
                                                class="w-5 h-5 text-primary shrink-0 mt-1"
                                                fill="none"
                                                stroke="currentColor"
                                                viewBox="0 0 24 24"
                                            >
                                                <path
                                                    stroke-linecap="round"
                                                    stroke-linejoin="round"
                                                    stroke-width="2"
                                                    d="M5 13l4 4L19 7"
                                                />
                                            </svg>
                                            <span>{point}</span>
                                        </li>
                                    ))}
                                </ul>
                            </div>
                        ))
                    }
                </div>
            </div>
        </section>

        <!-- Process -->
        <section class="py-24 bg-white reveal">
            <div class="container mx-auto px-6">
                <div class="text-center mb-16">
                    <h2
                        class="text-sm font-bold text-primary tracking-widest uppercase mb-3"
                    >
                        Our Process
                    </h2>
                    <h3 class="text-3xl md:text-4xl font-bold text-neutral-900">
                        How We Build Your Website
                    </h3>
                </div>

                <div class="grid md:grid-cols-4 gap-8">
                    {
                        process.map((step) => (
                            <div class="relative">
                                <span class="text-6xl font-bold text-neutral-100 absolute -top-8 -left-4 z-0">
                                    {step.step}
                                </span>
                                <div class="relative z-10 pt-8">
                                    <h4 class="text-xl font-bold text-neutral-900 mb-3">
                                        {step.title}
                                    </h4>
                                    <p class="text-neutral-600 text-sm">
                                        {step.description}
                                    </p>
                                </div>
                            </div>
                        ))
                    }
                </div>
            </div>
        </section>

        <!-- Benefits -->
        <section class="py-24 bg-neutral-50 reveal">
            <div class="container mx-auto px-6">
                <div class="max-w-4xl mx-auto">
                    <h3
                        class="text-3xl font-bold text-neutral-900 mb-8 text-center"
                    >
                        Key Benefits
                    </h3>
                    <div class="grid md:grid-cols-2 gap-6">
                        {
                            benefits.map((benefit) => (
                                <div class="flex items-center gap-4 p-6 bg-white rounded-xl shadow-sm">
                                    <div class="w-2 h-2 rounded-full bg-primary shrink-0" />
                                    <p class="text-neutral-700 font-medium">
                                        {benefit}
                                    </p>
                                </div>
                            ))
                        }
                    </div>
                </div>
            </div>
        </section>

        <!-- CTA -->
        <section class="py-24 bg-primary text-white text-center reveal">
            <div class="container mx-auto px-6">
                <h2 class="text-4xl md:text-5xl font-bold mb-6">
                    Take Your Digital Presence to the Next Level
                </h2>
                <p class="text-xl text-white/90 mb-10 max-w-2xl mx-auto">
                    With Craft Presence, you’ll have a trusted partner committed
                    to delivering exceptional web development services that
                    bring your ideas to life.
                </p>
                <a
                    href="/contact"
                    class="inline-block px-10 py-5 bg-white text-primary font-bold text-lg rounded-full hover:bg-neutral-100 transition-all hover:scale-105 shadow-xl"
                >
                    Start Your Project
                </a>
            </div>
        </section>
    </main>
    <Footer />
</Layout>
