---
import Layout from "../../layouts/Layout.astro";
import Header from "../../components/Header.astro";
import Footer from "../../components/Footer.astro";
import PageHeader from "../../components/PageHeader.astro";

const features = [
    {
        title: "Seamless Shopping Experience",
        description:
            "We design user-friendly interfaces that make browsing and purchasing effortless for your customers.",
    },
    {
        title: "Secure and Scalable",
        description:
            "Our solutions prioritize security and are built to grow alongside your business needs.",
    },
    {
        title: "Conversion-Focused Design",
        description:
            "Every element is optimized to turn visitors into loyal customers and maximize sales.",
    },
];

const services = [
    {
        title: "Custom E-Commerce Store Design",
        points: [
            "Unique Storefronts: Designs tailored to your brand identity",
            "Responsive Layouts: Optimized for mobile, tablet, and desktop",
            "User-Centric UX/UI: Intuitive navigation for better engagement",
        ],
    },
    {
        title: "Platform Development & Integration",
        points: [
            "Shopify/WooCommerce/Magento: Expertise in leading platforms",
            "Custom CMS Solutions: Tailored management systems",
            "Third-Party Integrations: CRM, ERP, and marketing tools",
        ],
    },
    {
        title: "Secure Payment & Checkout Solutions",
        points: [
            "Multiple Gateway Integration: Stripe, PayPal, and more",
            "SSL Certification: Ensuring secure transactions",
            "Streamlined Checkout: Reducing cart abandonment rates",
        ],
    },
    {
        title: "Product & Inventory Management",
        points: [
            "Easy-to-Use Dashboards: Manage products effortlessly",
            "Automated Inventory Tracking: Real-time stock updates",
            "Bulk Upload Features: Efficient catalog management",
        ],
    },
    {
        title: "E-Commerce SEO & Marketing",
        points: [
            "Product Page Optimization: Better ranking for product searches",
            "Conversion Rate Optimization (CRO): Data-driven improvements",
            "Retargeting Strategies: Re-engage potential customers",
        ],
    },
];

const benefits = [
    "Increased Sales: Optimized user flows lead to higher conversion rates",
    "Global Reach: Expand your market beyond local boundaries",
    "24/7 Availability: Your store never closes, maximizing revenue potential",
    "Data-Driven Growth: Detailed analytics to inform business decisions",
];

const process = [
    {
        step: "01",
        title: "Requirement Analysis",
        description: "Understand business model, products, and target audience",
    },
    {
        step: "02",
        title: "Design & Prototyping",
        description: "Create visual mockups and user journey maps",
    },
    {
        step: "03",
        title: "Development & Integration",
        description: "Build store functionality and integrate payment systems",
    },
    {
        step: "04",
        title: "Testing & Launch",
        description: "Rigorous testing followed by smooth deployment",
    },
];
---

<Layout
    title="Ecommerce Development - Craft Presence"
    description="Grow Your Online Store"
>
    <Header />
    <main>
        <PageHeader
            title="Ecommerce Development"
            subtitle="Services to Grow Your Online Store"
        />

        <!-- Intro & Why Us -->
        <section class="py-24 bg-white reveal">
            <div class="container mx-auto px-6">
                <div class="max-w-4xl mx-auto text-center mb-16">
                    <p class="text-lg text-neutral-600 leading-relaxed mb-12">
                        At Craft Presence, we build powerful e-commerce
                        platforms that drive sales and provide exceptional
                        shopping experiences. Whether you're starting a new
                        online store or upgrading an existing one, our custom
                        e-commerce solutions are designed to meet your specific
                        business needs. From secure payment gateways to
                        intuitive product management, we ensure your online
                        business thrives in the digital marketplace.
                    </p>

                    <div class="grid md:grid-cols-3 gap-8 text-left">
                        {
                            features.map((feature) => (
                                <div class="p-6 bg-neutral-50 rounded-2xl border border-neutral-100">
                                    <h4 class="text-xl font-bold text-primary mb-3">
                                        {feature.title}
                                    </h4>
                                    <p class="text-neutral-600 text-sm">
                                        {feature.description}
                                    </p>
                                </div>
                            ))
                        }
                    </div>
                </div>
            </div>
        </section>

        <!-- Comprehensive Services -->
        <section class="py-24 bg-neutral-950 text-white reveal">
            <div class="container mx-auto px-6">
                <div class="text-center mb-16">
                    <h2
                        class="text-sm font-bold text-primary tracking-widest uppercase mb-3"
                    >
                        Our Services
                    </h2>
                    <h3 class="text-3xl md:text-4xl font-bold">
                        Comprehensive E-Commerce Solutions
                    </h3>
                </div>

                <div class="grid md:grid-cols-2 gap-8 max-w-5xl mx-auto">
                    {
                        services.map((service) => (
                            <div class="p-8 rounded-3xl bg-white/5 border border-white/5 hover:bg-white/10 transition-colors">
                                <h4 class="text-2xl font-bold text-white mb-6">
                                    {service.title}
                                </h4>
                                <ul class="space-y-3">
                                    {service.points.map((point) => (
                                        <li class="flex items-start gap-3 text-neutral-400">
                                            <svg
                                                class="w-5 h-5 text-primary shrink-0 mt-1"
                                                fill="none"
                                                stroke="currentColor"
                                                viewBox="0 0 24 24"
                                            >
                                                <path
                                                    stroke-linecap="round"
                                                    stroke-linejoin="round"
                                                    stroke-width="2"
                                                    d="M5 13l4 4L19 7"
                                                />
                                            </svg>
                                            <span>{point}</span>
                                        </li>
                                    ))}
                                </ul>
                            </div>
                        ))
                    }
                </div>
            </div>
        </section>

        <!-- Process -->
        <section class="py-24 bg-white reveal">
            <div class="container mx-auto px-6">
                <div class="text-center mb-16">
                    <h2
                        class="text-sm font-bold text-primary tracking-widest uppercase mb-3"
                    >
                        Our Process
                    </h2>
                    <h3 class="text-3xl md:text-4xl font-bold text-neutral-900">
                        Building Your Online Store
                    </h3>
                </div>

                <div class="grid md:grid-cols-4 gap-8">
                    {
                        process.map((step) => (
                            <div class="relative">
                                <span class="text-6xl font-bold text-neutral-100 absolute -top-8 -left-4 z-0">
                                    {step.step}
                                </span>
                                <div class="relative z-10 pt-8">
                                    <h4 class="text-xl font-bold text-neutral-900 mb-3">
                                        {step.title}
                                    </h4>
                                    <p class="text-neutral-600 text-sm">
                                        {step.description}
                                    </p>
                                </div>
                            </div>
                        ))
                    }
                </div>
            </div>
        </section>

        <!-- Benefits -->
        <section class="py-24 bg-neutral-50 reveal">
            <div class="container mx-auto px-6">
                <div class="max-w-4xl mx-auto">
                    <h3
                        class="text-3xl font-bold text-neutral-900 mb-8 text-center"
                    >
                        Key Benefits
                    </h3>
                    <div class="grid md:grid-cols-2 gap-6">
                        {
                            benefits.map((benefit) => (
                                <div class="flex items-center gap-4 p-6 bg-white rounded-xl shadow-sm">
                                    <div class="w-2 h-2 rounded-full bg-primary shrink-0" />
                                    <p class="text-neutral-700 font-medium">
                                        {benefit}
                                    </p>
                                </div>
                            ))
                        }
                    </div>
                </div>
            </div>
        </section>

        <!-- CTA -->
        <section class="py-24 bg-primary text-white text-center reveal">
            <div class="container mx-auto px-6">
                <h2 class="text-4xl md:text-5xl font-bold mb-6">
                    Start Selling Online Today
                </h2>
                <p class="text-xl text-white/90 mb-10 max-w-2xl mx-auto">
                    Partner with Craft Presence to build an online store that
                    delivers results.
                </p>
                <a
                    href="/contact"
                    class="inline-block px-10 py-5 bg-white text-primary font-bold text-lg rounded-full hover:bg-neutral-100 transition-all hover:scale-105 shadow-xl"
                >
                    Launch Your Store
                </a>
            </div>
        </section>
    </main>
    <Footer />
</Layout>
