---
import Layout from "../../layouts/Layout.astro";
import Header from "../../components/Header.astro";
import Footer from "../../components/Footer.astro";
import PageHeader from "../../components/PageHeader.astro";

const features = [
    {
        title: "Tailored Strategies Aligned with Your Goals",
        description:
            "Every business has unique needs. We analyze your business model and customize impactful marketing techniques to align with your objectives and audience preferences.",
    },
    {
        title: "Expert Digital Marketing Team",
        description:
            "Our seasoned team of marketers, designers, and strategists combines creativity, technical expertise, and data-driven insights to craft strategic marketing solutions that deliver exceptional results.",
    },
    {
        title: "Comprehensive Digital Marketing Solutions",
        description:
            "From SEO optimization to content creation and social media marketing, we offer end-to-end services to establish and grow your digital presence effectively.",
    },
];

const services = [
    {
        title: "Search Marketing & SEO Services",
        points: [
            "Keyword Research: Identify and target the right keywords your audience is searching for",
            "On-Page and Off-Page SEO: Optimize website content and secure authoritative backlinks for improved rankings",
            "Local SEO: Reach nearby customers with location-specific strategies tailored to small businesses",
        ],
    },
    {
        title: "Content Marketing",
        points: [
            "Blog Writing: SEO-optimized, informative, and engaging content tailored to your audience’s interests",
            "Social Media Content: Shareable, impactful posts that build brand awareness and boost engagement",
            "Email Marketing: Personalized campaigns designed to nurture leads and drive conversions",
        ],
    },
    {
        title: "Social Media Marketing",
        points: [
            "Platform-Specific Strategies: Tailored plans for platforms like Facebook, Instagram, LinkedIn, and Twitter",
            "Ad Campaigns: Targeted social media ads to maximize reach and drive traffic",
            "Community Engagement: Foster lasting relationships with your audience through active interactions",
        ],
    },
    {
        title: "Pay-Per-Click Advertising (PPC)",
        points: [
            "Google Ads: Drive targeted traffic with high-performing, data-driven ad campaigns",
            "Social Media Ads: Boost brand visibility through well-targeted, creative ads",
            "Analytics and Optimization: Continuously monitor and fine-tune campaigns for optimal performance",
        ],
    },
    {
        title: "Strategic Marketing Solutions",
        points: [
            "Data-Driven Insights: Leverage analytics to make informed decisions and refine strategies",
            "Integrated Campaigns: Seamlessly combine SEO, content marketing, and paid ads for maximum impact",
            "Brand Building: Strengthen online authority and establish a recognizable presence in your industry",
        ],
    },
];

const benefits = [
    "Increased Online Visibility: Climb higher on search engine rankings and attract the right audience",
    "Enhanced Audience Engagement: Build trust and foster meaningful connections through impactful content",
    "Higher Conversion Rates: Turn visitors into loyal customers with targeted marketing strategies",
    "Scalable Solutions: Services that evolve with your business growth from startup to enterprise",
];

const process = [
    {
        step: "01",
        title: "Understand Your Goals",
        description:
            "Analyze business objectives, target audience, and industry challenges",
    },
    {
        step: "02",
        title: "Craft Custom Strategy",
        description:
            "Develop personalized digital marketing plan tailored to your goals",
    },
    {
        step: "03",
        title: "Execute with Precision",
        description:
            "Implement strategies with attention to detail and focus on results",
    },
    {
        step: "04",
        title: "Monitor and Optimize",
        description:
            "Continuously track performance and make data-driven adjustments",
    },
];
---

<Layout
    title="Digital Marketing - Craft Presence"
    description="Transform Your Business"
>
    <Header />
    <main>
        <PageHeader
            title="Digital Marketing"
            subtitle="Services to Transform Your Business"
        />

        <!-- Intro & Why Us -->
        <section class="py-24 bg-white reveal">
            <div class="container mx-auto px-6">
                <div class="max-w-4xl mx-auto text-center mb-16">
                    <p class="text-lg text-neutral-600 leading-relaxed mb-12">
                        At Craft Presence, our tailored digital marketing
                        services are designed to enhance your brand visibility,
                        connect you with your target audience, and achieve
                        measurable growth. Whether you’re looking to implement
                        effective online marketing strategies, optimize your SEO
                        for startups, or create a comprehensive digital
                        presence, we offer personalized solutions for businesses
                        of all sizes to thrive in today’s competitive digital
                        world.
                    </p>

                    <div class="grid md:grid-cols-3 gap-8 text-left">
                        {
                            features.map((feature) => (
                                <div class="p-6 bg-neutral-50 rounded-2xl border border-neutral-100">
                                    <h4 class="text-xl font-bold text-primary mb-3">
                                        {feature.title}
                                    </h4>
                                    <p class="text-neutral-600 text-sm">
                                        {feature.description}
                                    </p>
                                </div>
                            ))
                        }
                    </div>
                </div>
            </div>
        </section>

        <!-- Comprehensive Services -->
        <section class="py-24 bg-neutral-950 text-white reveal">
            <div class="container mx-auto px-6">
                <div class="text-center mb-16">
                    <h2
                        class="text-sm font-bold text-primary tracking-widest uppercase mb-3"
                    >
                        Our Services
                    </h2>
                    <h3 class="text-3xl md:text-4xl font-bold">
                        Comprehensive Marketing Solutions
                    </h3>
                </div>

                <div class="grid md:grid-cols-2 gap-8 max-w-5xl mx-auto">
                    {
                        services.map((service) => (
                            <div class="p-8 rounded-3xl bg-white/5 border border-white/5 hover:bg-white/10 transition-colors">
                                <h4 class="text-2xl font-bold text-white mb-6">
                                    {service.title}
                                </h4>
                                <ul class="space-y-3">
                                    {service.points.map((point) => (
                                        <li class="flex items-start gap-3 text-neutral-400">
                                            <svg
                                                class="w-5 h-5 text-primary shrink-0 mt-1"
                                                fill="none"
                                                stroke="currentColor"
                                                viewBox="0 0 24 24"
                                            >
                                                <path
                                                    stroke-linecap="round"
                                                    stroke-linejoin="round"
                                                    stroke-width="2"
                                                    d="M5 13l4 4L19 7"
                                                />
                                            </svg>
                                            <span>{point}</span>
                                        </li>
                                    ))}
                                </ul>
                            </div>
                        ))
                    }
                </div>
            </div>
        </section>

        <!-- Process -->
        <section class="py-24 bg-white reveal">
            <div class="container mx-auto px-6">
                <div class="text-center mb-16">
                    <h2
                        class="text-sm font-bold text-primary tracking-widest uppercase mb-3"
                    >
                        Our Process
                    </h2>
                    <h3 class="text-3xl md:text-4xl font-bold text-neutral-900">
                        Our Proven Approach
                    </h3>
                </div>

                <div class="grid md:grid-cols-4 gap-8">
                    {
                        process.map((step) => (
                            <div class="relative">
                                <span class="text-6xl font-bold text-neutral-100 absolute -top-8 -left-4 z-0">
                                    {step.step}
                                </span>
                                <div class="relative z-10 pt-8">
                                    <h4 class="text-xl font-bold text-neutral-900 mb-3">
                                        {step.title}
                                    </h4>
                                    <p class="text-neutral-600 text-sm">
                                        {step.description}
                                    </p>
                                </div>
                            </div>
                        ))
                    }
                </div>
            </div>
        </section>

        <!-- Benefits -->
        <section class="py-24 bg-neutral-50 reveal">
            <div class="container mx-auto px-6">
                <div class="max-w-4xl mx-auto">
                    <h3
                        class="text-3xl font-bold text-neutral-900 mb-8 text-center"
                    >
                        Key Benefits
                    </h3>
                    <div class="grid md:grid-cols-2 gap-6">
                        {
                            benefits.map((benefit) => (
                                <div class="flex items-center gap-4 p-6 bg-white rounded-xl shadow-sm">
                                    <div class="w-2 h-2 rounded-full bg-primary shrink-0" />
                                    <p class="text-neutral-700 font-medium">
                                        {benefit}
                                    </p>
                                </div>
                            ))
                        }
                    </div>
                </div>
            </div>
        </section>

        <!-- CTA -->
        <section class="py-24 bg-primary text-white text-center reveal">
            <div class="container mx-auto px-6">
                <h2 class="text-4xl md:text-5xl font-bold mb-6">
                    Let’s Transform Your Digital Presence
                </h2>
                <p class="text-xl text-white/90 mb-10 max-w-2xl mx-auto">
                    With Craft Presence, you gain a trusted partner dedicated to
                    helping you achieve digital success.
                </p>
                <a
                    href="/contact"
                    class="inline-block px-10 py-5 bg-white text-primary font-bold text-lg rounded-full hover:bg-neutral-100 transition-all hover:scale-105 shadow-xl"
                >
                    Scale Your Business
                </a>
            </div>
        </section>
    </main>
    <Footer />
</Layout>
