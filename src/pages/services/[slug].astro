---
export const prerender = false;

import type { APIRoute } from "astro";

const US_COUNTRIES = new Set(["US"]);
const US_SERVICE_SLUGS = new Set(["seo-services", "web-development"]);

export const GET: APIRoute = ({ params, request, redirect }) => {
	const slug = params.slug;
	if (!slug) {
		return redirect("/in", 302);
	}

	const country =
		request.headers.get("CF-IPCountry") ??
		request.headers.get("cf-ipcountry") ??
		"";

	const region = US_COUNTRIES.has(country.toUpperCase()) ? "us" : "in";
	const targetRegion =
		region === "us" && US_SERVICE_SLUGS.has(slug) ? "us" : "in";
	return redirect(`/${targetRegion}/services/${slug}`, 302);
};
