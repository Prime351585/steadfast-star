---
import Layout from "../layouts/Layout.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import PageHeader from "../components/PageHeader.astro";
import { Image } from "astro:assets";
import HeroImg from "../assets/canva_assets/C4.png";
import W1 from "../assets/canva_assets/W1.png";
import W2 from "../assets/canva_assets/W2.png";
import W3 from "../assets/canva_assets/W3.png";
import W4 from "../assets/canva_assets/W4.png";
import footerImg from "../assets/canva_assets/C5.png";
const values = [
    {
        title: "Creativity",
        description:
            "We think outside the box to deliver unique solutions tailored to your business.",
        img_link: W1,
    },
    {
        title: "Transparency",
        description:
            "Open communication and honesty are at the heart of everything we do.",
        img_link: W2,
    },
    {
        title: "Collaboration",
        description:
            "We work closely with our clients, treating them as partners in every project.",
        img_link: W3,
    },
    {
        title: "Excellence",
        description:
            "Our commitment to quality ensures we exceed expectations in every endeavor.",
        img_link: W4,
    },
];

const offerings = [
    {
        title: "Web Development and Design",
        description:
            "Create websites that are not only visually appealing but also built for conversion. With seamless navigation and responsive layouts, we ensure your visitors turn into loyal customers.",
    },
    {
        title: "SEO and Digital Marketing",
        description:
            "Optimize your website to rank higher on search engines and attract organic traffic. Our SEO services drive measurable results and long-term growth.",
    },
    {
        title: "Branding and Creative Services",
        description:
            "Build a brand that resonates with your audience. From logo design to messaging strategy, we help you create a strong and memorable identity.",
    },
    {
        title: "E-commerce Development",
        description:
            "Launch or enhance your online store with custom e-commerce solutions that improve user experience, boost conversions, and drive sales.",
    },
];
---

<Layout
    title="About Us - Craft Presence"
    description="Empowering Your Digital Success"
>
    <Header />
    <main>
        <PageHeader
            title="About Us"
            subtitle="Empowering Your Digital Success"
        />

        <!-- Who We Are & Mission -->
        <section class="py-24 bg-white">
            <div class="container mx-auto px-6">
                <div class="grid md:grid-cols-2 gap-16 items-center">
                    <div>
                        <h2
                            class="text-sm font-bold text-primary tracking-widest uppercase mb-3"
                        >
                            Who We Are
                        </h2>
                        <h3
                            class="text-3xl md:text-4xl font-bold text-neutral-900 mb-6"
                        >
                            Crafting Your Digital Presence
                        </h3>
                        <p
                            class="text-neutral-600 text-lg leading-relaxed mb-6"
                        >
                            At Craft Presence, we believe every business has a
                            unique story to tell. Our team of expert designers,
                            developers, and marketers specialize in crafting
                            strategies that amplify your voice, enhance your
                            online presence, and deliver measurable results.
                            From building stunning websites to creating
                            compelling marketing campaigns, we are your partner
                            in growth and success.
                        </p>
                        <div
                            class="bg-neutral-50 p-8 rounded-2xl border-l-4 border-primary"
                        >
                            <h4 class="text-xl font-bold text-neutral-900 mb-2">
                                Our Mission
                            </h4>
                            <p class="text-neutral-600">
                                Our mission is simple: to help businesses
                                succeed online by leveraging cutting-edge
                                digital marketing techniques. We aim to create
                                meaningful connections between your brand and
                                your audience, fostering trust, engagement, and
                                long-term success.
                            </p>
                        </div>
                    </div>
                    <div class="relative">
                        <div
                            class="absolute inset-0 bg-primary/10 rounded-3xl transform rotate-3"
                        >
                        </div>
                        <Image
                            src={HeroImg}
                            alt="Team collaboration"
                            width={500}
                            height={500}
                            format="avif"
                            class="w-full h-full relative rounded-3xl shadow-xl"
                        />
                    </div>
                </div>
            </div>
        </section>

        <!-- Core Values -->
        <section class="py-24 bg-neutral-950 text-white">
            <div class="container mx-auto px-6">
                <div class="text-center max-w-3xl mx-auto mb-16">
                    <h2
                        class="text-sm font-bold text-primary tracking-widest uppercase mb-3"
                    >
                        Our Values
                    </h2>
                    <h3 class="text-3xl md:text-4xl font-bold mb-6">
                        What Drives Us
                    </h3>
                </div>

                <div class="grid md:grid-cols-2 lg:grid-cols-4 gap-8">
                    {
                        values.map((value) => (
                            <div>
                                <Image
                                    src={value.img_link}
                                    alt="What Drive Us"
                                    width={100}
                                    height={100}
                                    class="w-30 h-35 item mx-auto p-3"
                                />
                                <div class="p-6 rounded-2xl bg-white/5 border border-white/5">
                                    <h4 class="text-xl font-bold text-primary mb-3">
                                        {value.title}
                                    </h4>
                                    <p class="text-neutral-400">
                                        {value.description}
                                    </p>
                                </div>
                            </div>
                        ))
                    }
                </div>
            </div>
        </section>

        <!-- What We Offer -->
        <section class="py-24 bg-neutral-50">
            <div class="container mx-auto px-6">
                <div class="text-center max-w-3xl mx-auto mb-16">
                    <h2
                        class="text-sm font-bold text-primary tracking-widest uppercase mb-3"
                    >
                        Our Expertise
                    </h2>
                    <h3
                        class="text-3xl md:text-4xl font-bold text-neutral-900 mb-6"
                    >
                        Comprehensive Digital Services
                    </h3>
                </div>

                <div class="grid md:grid-cols-2 gap-8">
                    {
                        offerings.map((item) => (
                            <div class="flex gap-6 p-8 rounded-3xl bg-white border border-neutral-100 shadow-sm">
                                <div class="shrink-0 w-12 h-12 rounded-full bg-primary/10 flex items-center justify-center text-primary">
                                    <svg
                                        class="w-6 h-6"
                                        fill="none"
                                        stroke="currentColor"
                                        viewBox="0 0 24 24"
                                    >
                                        <path
                                            stroke-linecap="round"
                                            stroke-linejoin="round"
                                            stroke-width="2"
                                            d="M5 13l4 4L19 7"
                                        />
                                    </svg>
                                </div>
                                <div>
                                    <h4 class="text-xl font-bold text-neutral-900 mb-3">
                                        {item.title}
                                    </h4>
                                    <p class="text-neutral-600 leading-relaxed">
                                        {item.description}
                                    </p>
                                </div>
                            </div>
                        ))
                    }
                </div>
            </div>
        </section>

        <!-- CTA -->
        <section class="py-24 bg-primary text-white text-center">
            <div class="container mx-auto px-6 md:grid grid-cols-4">
                <div class="col-span-1">
                    <Image
                        src={footerImg}
                        alt="Team collaboration"
                        width={300}
                        height={300}
                        format="avif"
                        class="w-full h-full relative rounded-3xl shadow-xl hidden md:block"
                    />
                </div>

                <div class="col-span-3">
                    <h2 class="text-4xl md:text-5xl font-bold mb-6">
                        Let's Work Together
                    </h2>
                    <p class="text-xl text-white/90 mb-10 max-w-2xl mx-auto">
                        At Craft Presence, we are more than just a digital
                        marketing agency—we're your partner in achieving lasting
                        success.
                    </p>
                    <a
                        href="/contact"
                        class="inline-block px-10 py-5 bg-white text-primary font-bold text-lg rounded-full shadow-xl"
                    >
                        Contact Us Today
                    </a>
                </div>
            </div>
        </section>
    </main>
    <Footer />
</Layout>
