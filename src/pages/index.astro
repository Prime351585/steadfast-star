---
import Layout from "../layouts/Layout.astro";
import Header from "../components/Header.astro";
import Hero from "../components/Hero.astro";
import Introduction from "../components/Introduction.astro";
import KeyReasons from "../components/KeyReasons.astro";
import WhyUs from "../components/WhyUs.astro";
import Services from "../components/Services.astro";
import Impact from "../components/Impact.astro";
import Process from "../components/Process.astro";
import Approach from "../components/Approach.astro";
import Industries from "../components/Industries.astro";
import Testimonials from "../components/Testimonials.astro";
import FAQ from "../components/FAQ.astro";
import Footer from "../components/Footer.astro";
import { Image } from "astro:assets";
import FooterImage from "../assets/canva_assets/C3.png";
---

<Layout
	title="Craft Presence: AI-powered Digital Marketing Company In India"
	description="Grow your business with Craft Presence, a result-driven digital marketing agency."
>
	<Header />
	<main>
		<Hero />
		<Introduction />
		<KeyReasons />
		<WhyUs />
		<Services />
		<Impact />
		<Process />
		<Approach />
		<Industries />
		<Testimonials />
		<FAQ />

		<!-- Call to Action Section -->
		<section
			id="contact"
			class="py-24 bg-primary text-white text-center relative overflow-hidden"
		>
			<div class="absolute inset-0 bg-black/10"></div>
			<div class="md:grid grid-cols-3">
				<div class="container mx-auto px-6 relative z-10 col-span-2">
					<h2
						class="text-4xl md:text-6xl font-bold mb-6 md:text-left md:ml-15"
					>
						Dominate Your Local Market
					</h2>
					<p
						class="text-xl text-white/90 mb-10 max-w-2xl mx-auto md:text-left"
					>
						We're dedicated to helping businesses succeed locally
						through tailored SEO solutions. Get a free digital
						marketing audit or speak directly with the Craft
						Presence team to explore growth-driven digital
						strategies for your online business.
					</p>
					<div class="text-left ml-15">
						<a
							href="mailto:info@craftpresence.com"
							class="inline-block px-10 py-5 bg-white text-primary font-bold text-lg rounded-full hover:bg-neutral-100 shadow-xl"
						>
							Get Found Locally
						</a>
					</div>
				</div>
				<Image
					src={FooterImage}
					alt={"Dominate your market image"}
					width={300}
					height={300}
					class="w-full h-full col-span-1 rounded-[20%] p-4 hidden md:block"
				/>
			</div>
		</section>
	</main>
	<Footer />
</Layout>
