---
import type { HomepageContent } from "../data/homepage/types";

interface Props {
	content: HomepageContent["hero"];
}

const { content } = Astro.props;
---

<section
    class="relative min-h-screen flex items-center justify-center overflow-hidden bg-neutral-950 text-white pt-32 pb-20 select-none"
>
    <!-- Technical Grid Background -->
    <div
        class="absolute inset-0 bg-[linear-gradient(to_right,#80808012_1px,transparent_1px),linear-gradient(to_bottom,#80808012_1px,transparent_1px)] bg-[size:24px_24px]"
    >
        <div
            class="absolute left-0 right-0 top-0 -z-10 m-auto h-[310px] w-[310px] rounded-full bg-primary opacity-20 blur-[100px]"
        >
        </div>
    </div>

    <div class="container mx-auto px-6 relative z-10">
        <div class="flex flex-col lg:flex-row items-center gap-16 lg:gap-24">
            <!-- Left Content: High Conversion Copy -->
            <div class="lg:w-1/2 text-center lg:text-left">
                <div
                    class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-white/5 border border-white/10 text-xs font-medium text-neutral-300 mb-8"
                >
                    <span class="w-1.5 h-1.5 rounded-full bg-green-500"></span>
                    {content.badge}
                </div>

                <h1
                    class="text-4xl lg:text-5xl font-bold font-sans tracking-tight mb-6 leading-[1.1]"
                >
                    {content.titleAccent ? (
                        <>
                            {content.title}<br />
                            <span class="text-white/50">{content.titleAccent}</span>
                        </>
                    ) : (
                        content.title
                    )}
                </h1>

                <p
                    class="text-xl text-neutral-400 mb-10 leading-relaxed content-width mx-auto lg:mx-0"
                >
                    {content.subheadline}
                </p>

                <div
                    class="flex flex-col sm:flex-row items-center gap-4 justify-center lg:justify-start"
                >
                    <button
                        id="openHeroModal"
                        class="w-full sm:w-auto px-8 py-4 bg-white text-black font-bold rounded-lg hover:bg-neutral-200 flex items-center justify-center gap-2"
                    >
                        {content.primaryCta}
                        <svg
                            class="w-4 h-4"
                            fill="none"
                            stroke="currentColor"
                            viewBox="0 0 24 24"
                            ><path
                                stroke-linecap="round"
                                stroke-linejoin="round"
                                stroke-width="2"
                                d="M17 8l4 4m0 0l-4 4m4-4H3"></path></svg
                        >
                    </button>
                    <a
                        href="#portfolio"
                        class="w-full sm:w-auto px-8 py-4 bg-transparent border border-white/20 text-white font-semibold rounded-lg hover:bg-white/5 flex items-center justify-center"
                    >
                        {content.secondaryCta}
                    </a>
                </div>

                    <div
                        class="mt-12 pt-8 border-t border-white/10 flex flex-col lg:flex-row items-center gap-6 justify-center lg:justify-start lg:gap-8"
                    >
                        <div class="flex flex-wrap items-center justify-center lg:justify-start gap-3 sm:gap-4 text-xs text-neutral-400">
                            {content.stats.map((stat, index) => (
                                <span class="flex items-center gap-1">
                                    {index > 0 && (
                                        <span class={`text-white/30 mx-1 sm:mx-2 ${index === 1 ? "hidden sm:inline" : "hidden md:inline"}`}>&bull;</span>
                                    )}
                                    <strong class="text-white text-sm">{stat.value}</strong>
                                    <span>{stat.label}</span>
                                </span>
                            ))}
                        </div>
                        
                        {content.showTrustpilot && (
                            <>
                                <div class="h-4 w-px bg-white/20 hidden xl:block"></div>
                                
                                <div
                                    class="flex items-center justify-center gap-1.5 text-yellow-400 text-sm font-bold shrink-0"
                                >
                                    <span>★★★★★</span>
                                    <span class="text-neutral-400 font-normal ml-1"
                                        >4.7 Rating on Trustpilot</span
                                    >
                                </div>
                            </>
                        )}
                    </div>
            </div>

            <!-- Right Content: The "Engine" Visual -->
            <div class="lg:w-1/2 w-full relative">
                <!-- Main Glass Card -->
                <div
                    class="relative z-10 bg-neutral-900/50 backdrop-blur-2xl border border-white/10 rounded-2xl p-6 shadow-2xl shadow-black/50 overflow-hidden"
                >
                    <!-- Header of Card -->
                    <div
                        class="flex items-center justify-between mb-8 border-b border-white/5 pb-4"
                    >
                        <div class="flex items-center gap-3">
                            <div class="w-3 h-3 rounded-full bg-red-500"></div>
                            <div class="w-3 h-3 rounded-full bg-yellow-500">
                            </div>
                            <div class="w-3 h-3 rounded-full bg-green-500">
                            </div>
                        </div>
                        <div class="text-xs font-mono text-neutral-500">
                            growth_engine.exe
                        </div>
                    </div>

                    <!-- Graph Visual (CSS/SVG) -->
                    <div class="relative h-64 w-full">
                        <!-- Grid Lines -->
                        <div
                            class="absolute inset-0 flex flex-col justify-between opacity-10"
                        >
                            <div class="w-full h-px bg-white"></div>
                            <div class="w-full h-px bg-white"></div>
                            <div class="w-full h-px bg-white"></div>
                            <div class="w-full h-px bg-white"></div>
                            <div class="w-full h-px bg-white"></div>
                        </div>

                        <!-- The Graph Line -->
                        <svg
                            class="absolute inset-0 w-full h-full"
                            overflow="visible"
                        >
                            <defs>
                                <linearGradient
                                    id="gradient"
                                    x1="0%"
                                    y1="0%"
                                    x2="0%"
                                    y2="100%"
                                >
                                    <stop
                                        offset="0%"
                                        style="stop-color:#8b5cf6;stop-opacity:0.3"
                                    ></stop>
                                    <stop
                                        offset="100%"
                                        style="stop-color:#8b5cf6;stop-opacity:0"
                                    ></stop>
                                </linearGradient>
                            </defs>
                            <path
                                d="M0,250 C50,240 100,200 150,210 C200,220 250,150 300,160 C350,170 400,80 450,90 C500,100 550,20 600,10"
                                fill="url(#gradient)"
                                stroke="#8b5cf6"
                                stroke-width="3"
                                stroke-linecap="round"
                                class="drop-shadow-lg"></path>
                            <!-- Static Point at End -->
                            <circle cx="600" cy="10" r="4" fill="white"
                            ></circle>
                        </svg>

                        <!-- Floating Stats Cards -->
                        <div
                            class="absolute top-10 left-10 bg-neutral-800/90 backdrop-blur border border-white/10 rounded-lg p-3 shadow-lg cursor-default"
                        >
                            <div class="text-xs text-neutral-400 mb-1">
                                Conversion Rate
                            </div>
                            <div class="text-xl font-bold text-green-400">
                                ↑ 4.8%
                            </div>
                        </div>

                        <div
                            class="absolute bottom-12 right-10 bg-neutral-800/90 backdrop-blur border border-white/10 rounded-lg p-3 shadow-lg cursor-default"
                        >
                            <div class="text-xs text-neutral-400 mb-1">
                                Monthly Leads
                            </div>
                            <div class="text-xl font-bold text-white">
                                2,405
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Abstract Glow Behind -->
                <div
                    class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[120%] h-[120%] bg-primary/20 blur-[120px] -z-10 rounded-full"
                >
                </div>
            </div>
        </div>
    </div>
</section>

<!-- Lead Capture Modal -->
<div id="heroLeadModal" class="fixed inset-0 z-50 hidden items-center justify-center overflow-y-auto overflow-x-hidden bg-black/80 p-4 sm:p-6 backdrop-blur-sm">
    <div class="relative w-full max-w-2xl rounded-2xl bg-white p-6 shadow-2xl sm:p-10 my-auto" id="heroModalContent">
        <button id="closeHeroModal" class="absolute right-4 top-4 rounded-full p-2 text-neutral-500 hover:bg-neutral-100 transition-colors">
            <svg class="h-6 w-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path>
            </svg>
        </button>
        
        <h2 class="mb-2 text-2xl sm:text-3xl font-bold text-neutral-900 pr-8">
            Get Your Free Digital Marketing Audit
        </h2>
        <p class="mb-6 text-neutral-600">
            Our experts will analyze your current digital presence and provide a customized growth plan.
        </p>
        
        <form id="modalLeadForm" class="space-y-4">
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                <div>
                    <label class="mb-1.5 block text-sm font-semibold text-neutral-700">First Name</label>
                    <input type="text" id="modalFirstName" class="w-full rounded-xl border border-neutral-300 px-4 py-2.5 outline-none transition-all focus:border-primary focus:ring-2 focus:ring-primary/20 text-neutral-900" placeholder="John" required />
                </div>
                <div>
                    <label class="mb-1.5 block text-sm font-semibold text-neutral-700">Last Name</label>
                    <input type="text" id="modalLastName" class="w-full rounded-xl border border-neutral-300 px-4 py-2.5 outline-none transition-all focus:border-primary focus:ring-2 focus:ring-primary/20 text-neutral-900" placeholder="Doe" required />
                </div>
            </div>
            
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                <div>
                    <label class="mb-1.5 block text-sm font-semibold text-neutral-700">Email Address</label>
                    <input type="email" id="modalEmail" class="w-full rounded-xl border border-neutral-300 px-4 py-2.5 outline-none transition-all focus:border-primary focus:ring-2 focus:ring-primary/20 text-neutral-900" placeholder="john@company.com" required />
                </div>
                <div>
                    <label class="mb-1.5 block text-sm font-semibold text-neutral-700">Phone Number</label>
                    <input type="tel" id="modalPhone" class="w-full rounded-xl border border-neutral-300 px-4 py-2.5 outline-none transition-all focus:border-primary focus:ring-2 focus:ring-primary/20 text-neutral-900" placeholder="+91 98765 43210" required />
                </div>
            </div>
            
            <div>
                <label class="mb-1.5 block text-sm font-semibold text-neutral-700">Company Website</label>
                <input type="url" id="modalWebsite" class="w-full rounded-xl border border-neutral-300 px-4 py-2.5 outline-none transition-all focus:border-primary focus:ring-2 focus:ring-primary/20 text-neutral-900" placeholder="https://www.yourwebsite.com" />
            </div>
            
            <div>
                <label class="mb-1.5 block text-sm font-semibold text-neutral-700">What is your biggest marketing challenge?</label>
                <textarea id="modalChallenge" class="h-24 w-full resize-none rounded-xl border border-neutral-300 px-4 py-2.5 outline-none transition-all focus:border-primary focus:ring-2 focus:ring-primary/20 text-neutral-900" placeholder="Tell us about your goals..."></textarea>
            </div>
            
            <button type="submit" class="w-full rounded-xl bg-primary py-3.5 text-center text-lg font-bold text-white shadow-lg transition-colors hover:bg-neutral-900 hover:shadow-xl mt-2">
                Request Free Audit
            </button>
            <p class="text-center text-xs text-neutral-500 mt-2">We respect your privacy. No spam, ever.</p>
        </form>
    </div>
</div>

<script>
    const openBtn = document.getElementById('openHeroModal');
    const closeBtn = document.getElementById('closeHeroModal');
    const modal = document.getElementById('heroLeadModal');
    const modalForm = document.getElementById('modalLeadForm');

    if (openBtn && closeBtn && modal) {
        openBtn.addEventListener('click', (e) => {
            e.preventDefault();
            modal.classList.remove('hidden');
            modal.classList.add('flex');
            document.body.style.overflow = 'hidden';
        });

        const closeModal = () => {
            modal.classList.add('hidden');
            modal.classList.remove('flex');
            document.body.style.overflow = '';
        };

        closeBtn.addEventListener('click', closeModal);

        modal.addEventListener('click', (e) => {
            if (e.target === modal) {
                closeModal();
            }
        });
    }

    if (modalForm) {
        modalForm.addEventListener('submit', function(e) {
            e.preventDefault();
            
            const firstName = (document.getElementById('modalFirstName') as HTMLInputElement)?.value || '';
            const lastName = (document.getElementById('modalLastName') as HTMLInputElement)?.value || '';
            const email = (document.getElementById('modalEmail') as HTMLInputElement)?.value || '';
            const phone = (document.getElementById('modalPhone') as HTMLInputElement)?.value || '';
            const website = (document.getElementById('modalWebsite') as HTMLInputElement)?.value || '';
            const challenge = (document.getElementById('modalChallenge') as HTMLTextAreaElement)?.value || '';
            
            const message = `Hello! I'm requesting a Free Digital Marketing Audit.

*Name:* ${firstName} ${lastName}
*Email:* ${email}
*Phone:* ${phone}
*Website:* ${website || 'Not provided'}

*Biggest Challenge:*
${challenge || 'Not provided'}`;

            const encodedMessage = encodeURIComponent(message);
            const whatsappUrl = `https://wa.me/919211667489?text=${encodedMessage}`;
            
            window.open(whatsappUrl, '_blank');
        });
    }
</script>

<style>
    /* No animations */
</style>
