---
import type { HomepageContent } from "../data/homepage/types";

interface Props {
	content: HomepageContent["process"];
}

const { content } = Astro.props;
---

<section class="py-24 bg-neutral-900 text-white relative overflow-hidden">
    <div class="container mx-auto px-6 relative z-10">
        <div class="text-center content-width mx-auto mb-16">
            <h3 class="text-3xl md:text-5xl font-bold mb-6">
                {content.title}
            </h3>
            <p class="text-neutral-400 text-lg">
                {content.intro}
            </p>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-8">
            {
                content.steps.map((step) => (
                    <div class="relative p-8 rounded-2xl bg-white/5 border border-white/10 overflow-hidden">
                        <div class="text-6xl font-bold text-white/5 absolute top-4 right-4">
                            {step.number}
                        </div>
                        <div class="relative z-10">
                            <h4 class="text-xl font-bold mb-4 text-white">
                                {step.title}
                            </h4>
                            <p class="text-neutral-400 text-sm leading-relaxed">
                                {step.description}
                            </p>
                        </div>
                    </div>
                ))
            }
        </div>
    </div>
</section>
