---
const steps = [
    {
        number: "01",
        title: "Comprehensive digital audit",
        description:
            "Before any strategy is built, we conduct a thorough audit of your current digital presence: SEO health (technical issues, content gaps, backlink profile), paid media performance (ad efficiency, keyword coverage, ROAS), social media standing, competitor landscape, and website conversion rate. This audit surfaces the specific gaps that are costing you leads and revenue.",
    },
    {
        number: "02",
        title: "Custom strategy development",
        description: "Based on audit findings, our team develops an integrated digital marketing strategy covering which channels to prioritise, what content to create, which audiences to target, and what KPIs to measure against. Every strategy includes a 90-day roadmap with specific deliverables, timelines, and projected outcomes.",
    },
    {
        number: "03",
        title: "Precision implementation",
        description: "The Craft Presence execution team implements the strategy, technical SEO fixes, content publishing, Google Ads and Meta Ads setup, website optimisation, and social media activation, with full quality control at every stage. Campaigns go live only after pre-launch checklists are completed and tracking is verified.",
    },
    {
        number: "04",
        title: "Performance monitoring and continuous optimisation",
        description:
            "Digital marketing is not a set-and-forget activity. Craft Presence monitors campaign performance weekly, adjusting bids, refreshing ad creatives, updating content, and optimizing landing pages based on live data. Monthly strategy reviews ensure the direction stays aligned with your business goals as markets and algorithms evolve.",
    },
];
---

<section class="py-24 bg-neutral-900 text-white relative overflow-hidden">
    <div class="container mx-auto px-6 relative z-10">
        <div class="text-center max-w-3xl mx-auto mb-16">
            <h3 class="text-3xl md:text-5xl font-bold mb-6">
                How does Craft Presence deliver digital marketing results?
            </h3>
            <p class="text-neutral-400 text-lg">
                We deliver digital marketing results through a structured four-stage framework that begins with a full business audit and ends with continuously optimised, data-backed campaigns. This framework ensures every strategy is built on real performance data, not assumptions.
            </p>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-8">
            {
                steps.map((step, index) => (
                    <div class="relative p-8 rounded-2xl bg-white/5 border border-white/10 overflow-hidden">
                        <div class="text-6xl font-bold text-white/5 absolute top-4 right-4">
                            {step.number}
                        </div>
                        <div class="relative z-10">
                            <h4 class="text-xl font-bold mb-4 text-white">
                                {step.title}
                            </h4>
                            <p class="text-neutral-400 text-sm leading-relaxed">
                                {step.description}
                            </p>
                        </div>
                    </div>
                ))
            }
        </div>
    </div>
</section>
