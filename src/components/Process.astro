---
const steps = [
    {
        number: "01",
        title: "Comprehensive Audit",
        description:
            "Analyze current performance and local market opportunities.",
    },
    {
        number: "02",
        title: "Custom Strategy Development",
        description: "Create targeted plan for your community.",
    },
    {
        number: "03",
        title: "Precision Implementation",
        description: "Optimize GMB, website, and citations.",
    },
    {
        number: "04",
        title: "Performance Monitoring",
        description:
            "Continuously monitor performance and improve campaigns using data insights.",
    },
];
---

<section class="py-24 bg-neutral-900 text-white relative overflow-hidden">
    <div class="container mx-auto px-6 relative z-10">
        <div class="text-center max-w-3xl mx-auto mb-16">
            <h2
                class="text-sm font-bold text-primary tracking-widest uppercase mb-3"
            >
                Our Process
            </h2>
            <h3 class="text-3xl md:text-5xl font-bold mb-6">
                How We Deliver Consistent Results
            </h3>
            <p class="text-neutral-400 text-lg">
                Our proven 4-step framework for digital marketing success.
            </p>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-8">
            {
                steps.map((step, index) => (
                    <div class="relative p-8 rounded-2xl bg-white/5 border border-white/10 overflow-hidden">
                        <div class="text-6xl font-bold text-white/5 absolute top-4 right-4">
                            {step.number}
                        </div>
                        <div class="relative z-10">
                            <h4 class="text-xl font-bold mb-4 text-white">
                                {step.title}
                            </h4>
                            <p class="text-neutral-400 text-sm leading-relaxed">
                                {step.description}
                            </p>
                        </div>
                    </div>
                ))
            }
        </div>
    </div>
</section>
