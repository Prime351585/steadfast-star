---
import { Image } from "astro:assets";
import Layout from "../layouts/Layout.astro";
import Header from "./Header.astro";
import Footer from "./Footer.astro";
import type { ServicePageData } from "../data/services/types";

interface Props {
	data: ServicePageData;
}

const { data } = Astro.props;

const pageTitle = data.pageTitle ?? `${data.title} - Craft Presence`;
const introLabel = data.introLabel ?? "Introduction";
const showAboutHeading = data.showAboutHeading ?? true;
const servicesEyebrow = data.servicesSection?.eyebrow ?? "Our Expertise";
const servicesTitle = data.servicesSection?.title ?? "Service Specializations";
const faqTitle = data.faqTitle ?? "Frequently Asked Questions";
const faqSubtitle = data.faqSubtitle;
const processCols =
	data.process.steps.length <= 4 ? "md:grid-cols-4" : "md:grid-cols-5";

const images = import.meta.glob<{ default: ImageMetadata }>(
	"/src/assets/**/*.{jpeg,jpg,png,gif}",
);

function resolveImage(path?: string) {
	if (!path) return null;
	const key = path.replace("../../", "/src/");
	return images[key] ? images[key] : null;
}

const heroImage = resolveImage(data.heroImage);
const introImage = resolveImage(data.introImage);
const whyNeededImage1 = resolveImage(data.whyNeededImage1);
const whyNeededImage2 = resolveImage(data.whyNeededImage2);
const whyNeededImage3 = resolveImage(data.whyNeededImage3);
const whyNeededImage4 = resolveImage(data.whyNeededImage4);
---

<Layout title={pageTitle} description={data.metaDescription}>
	<Header />

	<main class="relative bg-white">
		<section
			class="relative pt-32 pb-20 lg:pt-48 lg:pb-32 overflow-hidden bg-neutral-950"
		>
			<div
				class="absolute inset-0 bg-[radial-gradient(circle_at_30%_-20%,rgba(var(--primary-rgb),0.2),transparent_50%)]"
			>
			</div>

			{
				heroImage && (
					<div class="absolute inset-0 z-0">
						<Image
							src={heroImage() as any}
							alt={data.h1}
							class="w-full h-full object-cover opacity-30 mix-blend-overlay"
						/>
						<div class="absolute inset-0 bg-neutral-950/60 shadow-[inset_0_0_100px_rgba(0,0,0,0.5)]" />
					</div>
				)
			}

			<div class="container mx-auto px-6 relative z-10">
				<div class="content-width">
					<h1
						class="text-3xl md:text-4xl lg:text-5xl font-bold text-white mb-6 leading-tight"
					>
						{data.h1}
					</h1>
					<p
						class="text-lg md:text-xl text-neutral-400 mb-10 content-width leading-relaxed"
					>
						{data.subheadline}
					</p>
					<div class="flex flex-wrap gap-4">
						{
							data.buttons.map((btn, index) => (
								<a
									href={btn.link}
									class={`px-8 py-4 rounded-full font-bold ${
										index === 0
											? "bg-primary text-white shadow-lg shadow-primary/25"
											: "bg-white/10 text-white backdrop-blur-md border border-white/10"
									}`}
								>
									{btn.text}
								</a>
							))
						}
					</div>
					{
						data.heroStats && data.heroStats.length > 0 && (
							<div class="mt-12 pt-8 border-t border-white/10 flex flex-wrap items-center gap-4 sm:gap-6 text-sm text-neutral-400">
								{
									data.heroStats.map((stat, index) => (
										<span class="flex items-center gap-2">
											{index > 0 && (
												<span class="hidden sm:inline text-white/30 mr-2">&bull;</span>
											)}
											<strong class="text-white text-base">{stat.value}</strong>
											<span>{stat.label}</span>
										</span>
									))
								}
							</div>
						)
					}
				</div>
			</div>
		</section>

		<section class="py-24 bg-white relative overflow-hidden">
			<div class="container mx-auto px-6 relative z-10">
				<div class="grid lg:grid-cols-2 gap-16 items-center">
					<div>
						<h2
							class="text-sm font-bold text-primary tracking-widest uppercase mb-4 font-display"
						>
							{introLabel}
						</h2>
						<p
							class="text-2xl md:text-3xl font-medium text-neutral-900 leading-tight mb-8 font-display"
						>
							{data.intro}
						</p>
						<div
							class="p-8 bg-neutral-50 rounded-3xl border border-neutral-100"
						>
							{
								showAboutHeading && (
									<h3
										class="text-xl font-bold text-neutral-900 mb-4 font-display"
									>
										About the Service
									</h3>
								)
							}
							<p
								class="text-neutral-600 leading-relaxed font-sans"
							>
								{data.about}
							</p>
						</div>
					</div>
					<div class="relative">
						<div
							class="aspect-square bg-neutral-100 rounded-3xl overflow-hidden shadow-2xl relative"
						>
							{
								introImage && (
									<Image
										src={introImage() as any}
										alt={data.h1}
										class="w-full h-full object-cover"
									/>
								)
							}
						</div>
						<div
							class="absolute -bottom-8 -right-8 bg-white p-8 rounded-2xl shadow-xl border border-neutral-100 hidden md:block"
						>
							<div
								class="text-4xl font-bold text-primary mb-1 font-display"
							>
								300+
							</div>
							<div
								class="text-sm text-neutral-500 uppercase tracking-wider font-semibold font-sans"
							>
								Projects Delivered
							</div>
						</div>
					</div>
				</div>
			</div>
		</section>

		<section class="py-24 bg-white">
			<div class="container mx-auto px-6">
				<div class="grid lg:grid-cols-2 gap-16 items-center">
					<div>
						<h2
							class="text-sm font-bold text-primary tracking-widest uppercase mb-4 font-display"
						>
							Key Value
						</h2>
						<h3
							class="text-3xl md:text-5xl font-bold text-neutral-900 mb-8 font-display"
						>
							{data.whyNeeded.title}
						</h3>
						{
							data.whyNeeded.intro && (
								<p class="text-neutral-600 leading-relaxed mb-8 font-sans">
									{data.whyNeeded.intro}
								</p>
							)
						}
						<div class="space-y-6">
							{
								data.whyNeeded.reasons.map((reason) => (
									<div class="flex gap-4">
										<div class="mt-1 shrink-0 w-6 h-6 rounded-full bg-primary/10 flex items-center justify-center text-primary font-bold text-xs">
											✓
										</div>
										<div>
											<h4 class="font-bold text-neutral-900 font-display">
												{reason.title}
											</h4>
											<p class="text-neutral-600 text-sm mt-1 font-sans">
												{reason.description}
											</p>
										</div>
									</div>
								))
							}
						</div>
					</div>
					<div class="grid grid-cols-2 gap-4">
						<div class="space-y-4 pt-12">
							<div
								class="aspect-square bg-neutral-100 rounded-3xl overflow-hidden"
							>
								{
									whyNeededImage1 && (
										<Image
											src={whyNeededImage1() as any}
											alt="Service illustration 1"
											class="w-full h-full object-cover"
										/>
									)
								}
							</div>
							<div
								class="aspect-3/4 bg-neutral-200 rounded-3xl overflow-hidden"
							>
								{
									whyNeededImage2 && (
										<Image
											src={whyNeededImage2() as any}
											alt="Service illustration 2"
											class="w-full h-full object-cover"
										/>
									)
								}
							</div>
						</div>
						<div class="space-y-4">
							<div
								class="aspect-3/4 bg-neutral-100/50 rounded-3xl ring-1 ring-neutral-200 overflow-hidden"
							>
								{
									whyNeededImage3 && (
										<Image
											src={whyNeededImage3() as any}
											alt="Service illustration 3"
											class="w-full h-full object-cover"
										/>
									)
								}
							</div>
							<div
								class="aspect-square bg-neutral-100 rounded-3xl overflow-hidden"
							>
								{
									whyNeededImage4 && (
										<Image
											src={whyNeededImage4() as any}
											alt="Service illustration 4"
											class="w-full h-full object-cover"
										/>
									)
								}
							</div>
						</div>
					</div>
				</div>
			</div>
		</section>

		<section class="py-24 bg-neutral-50">
			<div class="container mx-auto px-6">
				<div class="text-center mb-16 content-width mx-auto">
					<h2
						class="text-sm font-bold text-primary tracking-widest uppercase mb-4 font-display"
					>
						{data.whyChooseUs.title}
					</h2>
					<h3
						class="text-3xl md:text-5xl font-bold text-neutral-900 mb-6 font-display"
					>
						{data.whyChooseUs.subtitle}
					</h3>
					{
						data.whyChooseUs.intro && (
							<p class="text-neutral-600 text-lg leading-relaxed font-sans">
								{data.whyChooseUs.intro}
							</p>
						)
					}
				</div>
				<div class="grid md:grid-cols-2 lg:grid-cols-3 gap-8">
					{
						data.whyChooseUs.items.map((item) => (
							<div class="bg-white p-8 rounded-3xl border border-neutral-100 shadow-sm">
								<div class="w-12 h-12 bg-primary/10 rounded-xl flex items-center justify-center mb-6">
									<svg
										class="w-6 h-6 text-primary"
										fill="none"
										stroke="currentColor"
										viewBox="0 0 24 24"
									>
										<path
											stroke-linecap="round"
											stroke-linejoin="round"
											stroke-width="2"
											d="M5 13l4 4L19 7"
										/>
									</svg>
								</div>
								<h4 class="text-xl font-bold text-neutral-900 mb-3 font-display">
									{item.title}
								</h4>
								<p class="text-neutral-600 text-sm leading-relaxed font-sans">
									{item.description}
								</p>
							</div>
						))
					}
				</div>
			</div>
		</section>

		<section
			id="services"
			class="py-24 bg-neutral-950 text-white relative overflow-hidden"
		>
			<div class="absolute inset-0 opacity-10">
				<div
					class="absolute top-0 right-0 w-96 h-96 bg-primary rounded-full blur-[150px]"
				>
				</div>
				<div
					class="absolute bottom-0 left-0 w-96 h-96 bg-primary rounded-full blur-[150px]"
				>
				</div>
			</div>
			<div class="container mx-auto px-6 relative z-10">
				<div class="text-center mb-16 content-width mx-auto">
					<h2
						class="text-sm font-bold text-primary tracking-widest uppercase mb-4 font-display"
					>
						{servicesEyebrow}
					</h2>
					<h3
						class="text-3xl md:text-5xl font-bold mb-6 font-display"
					>
						{servicesTitle}
					</h3>
					{
						data.servicesSection?.intro && (
							<p class="text-neutral-400 text-lg leading-relaxed font-sans">
								{data.servicesSection.intro}
							</p>
						)
					}
				</div>
				<div class="grid md:grid-cols-2 lg:grid-cols-3 gap-8">
					{
						data.services.map((service) => (
							<div class="p-8 rounded-3xl bg-white/5 border border-white/10">
								<div class="w-12 h-12 bg-white/10 rounded-xl flex items-center justify-center mb-6">
									<svg
										class="w-6 h-6 text-primary"
										fill="none"
										stroke="currentColor"
										viewBox="0 0 24 24"
									>
										<path
											stroke-linecap="round"
											stroke-linejoin="round"
											stroke-width="2"
											d="M13 10V3L4 14h7v7l9-11h-7z"
										/>
									</svg>
								</div>
								<h4 class="text-2xl font-bold mb-4 font-display">
									{service.title}
								</h4>
								<p class="text-neutral-400 leading-relaxed font-sans">
									{service.description}
								</p>
							</div>
						))
					}
				</div>
			</div>
		</section>

		{
			data.tools && (
				<section class="py-24 bg-neutral-50 overflow-hidden">
					<div class="container mx-auto px-6">
						<div class="bg-white rounded-[3rem] p-12 md:p-20 shadow-xl border border-neutral-100 w-full">
							<div class="text-center mb-12">
								<h3 class="text-3xl font-bold text-neutral-900 mb-4 font-display">
									{data.tools.title}
								</h3>
								<div class="w-20 h-1 bg-primary mx-auto rounded-full" />
							</div>
							<div class="flex flex-wrap justify-center gap-4 md:gap-8">
								{data.tools.items.map((tool) => (
									<div class="px-6 py-3 bg-neutral-50 rounded-full text-neutral-700 font-medium border border-neutral-100 font-sans">
										{tool}
									</div>
								))}
							</div>
						</div>
					</div>
				</section>
			)
		}

		{
			data.industries && (
				<section class="py-24 bg-white overflow-hidden">
					<div class="container mx-auto px-6 text-center">
						<h3 class="text-3xl font-bold text-neutral-900 mb-12 font-display">
							{data.industries.title}
						</h3>
						<div class="flex flex-wrap justify-center gap-12">
							{data.industries.items.map((industry) => {
								const industryLogo = resolveImage(industry.logo);
								return (
									<div class="flex flex-col items-center gap-4">
										<div class="w-20 h-20 rounded-2xl bg-neutral-100 flex items-center justify-center overflow-hidden">
											{industryLogo ? (
												<Image
													src={industryLogo() as any}
													alt={industry.name}
													class="w-full h-full object-contain p-3"
												/>
											) : (
												<svg
													class="w-10 h-10 text-primary"
													fill="currentColor"
													viewBox="0 0 24 24"
												>
													<path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm0 18c-4.41 0-8-3.59-8-8s3.59-8 8-8 8 3.59 8 8-3.59 8-8 8z" />
												</svg>
											)}
										</div>
										<span class="font-semibold text-neutral-700 whitespace-nowrap font-sans">
											{industry.name}
										</span>
									</div>
								);
							})}
						</div>
					</div>
				</section>
			)
		}

		<section
			class="py-24 bg-neutral-950 text-white overflow-hidden relative"
		>
			<div class="container mx-auto px-6">
				<div class="text-center mb-20 content-width mx-auto">
					<h2
						class="text-sm font-bold text-primary tracking-widest uppercase mb-4 font-display"
					>
						{data.process.title}
					</h2>
					<h3
						class="text-3xl md:text-5xl font-bold mb-6 font-display"
					>
						{data.process.subtitle}
					</h3>
					{
						data.process.intro && (
							<p class="text-neutral-400 text-lg leading-relaxed font-sans">
								{data.process.intro}
							</p>
						)
					}
				</div>

				<div class={`grid gap-4 relative ${processCols}`}>
					<div
						class="absolute top-1/2 left-0 w-full h-px bg-white/10 hidden md:block z-0"
					>
					</div>

					{
						data.process.steps.map((step, idx) => (
							<div class="relative z-10 flex flex-col items-center text-center p-8 bg-white/5 backdrop-blur-sm rounded-3xl border border-white/10">
								<div class="w-16 h-16 bg-primary text-white text-2xl font-bold rounded-2xl flex items-center justify-center mb-8 shadow-lg shadow-primary/20">
									0{idx + 1}
								</div>
								<h4 class="text-xl font-bold mb-4 font-display">
									{step.title}
								</h4>
								<p class="text-neutral-400 text-sm leading-relaxed font-sans">
									{step.description}
								</p>
							</div>
						))
					}
				</div>
			</div>
		</section>

		{
			data.clientExperiences && data.clientExperiences.length > 0 && (
				<section class="py-24 bg-white relative">
					<div class="container mx-auto px-6">
						<div class="text-center mb-16">
							<h2
								class="text-sm font-bold text-primary tracking-widest uppercase mb-4 font-display"
							>
								Client Feedback
							</h2>
							<h3
								class="text-3xl md:text-5xl font-bold text-neutral-900 mb-6 font-display"
							>
								What our clients say
							</h3>
						</div>
						<div class="grid md:grid-cols-2 lg:grid-cols-4 gap-8">
							{data.clientExperiences.map((exp) => (
								<div class="bg-neutral-50 p-8 rounded-3xl border border-neutral-100 flex flex-col h-full">
									<div class="flex gap-1 text-primary mb-6">
										{[...Array(5)].map(() => (
											<svg
												class="w-5 h-5 fill-current"
												viewBox="0 0 20 20"
											>
												<path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z" />
											</svg>
										))}
									</div>
									<p class="text-neutral-600 italic mb-8 grow font-sans">
										"{exp.feedback}"
									</p>
									<div class="font-bold text-neutral-900 font-display">
										{exp.name}
									</div>
									<div class="text-sm text-neutral-500 font-sans">
										Business Owner
									</div>
								</div>
							))}
						</div>
					</div>
				</section>
			)
		}

		{
			data.midCtaSection && (
				<section class="py-24 bg-neutral-50">
					<div class="container mx-auto px-6">
						<div class="bg-white rounded-[3rem] p-12 md:p-16 shadow-xl border border-neutral-100 text-center content-width mx-auto">
							<h3 class="text-3xl md:text-4xl font-bold text-neutral-900 mb-6 font-display">
								{data.midCtaSection.title}
							</h3>
							<p class="text-neutral-600 text-lg leading-relaxed mb-8 font-sans">
								{data.midCtaSection.description}
							</p>
							{
								data.midCtaSection.buttonText && (
									<a
										href={data.midCtaSection.buttonLink ?? "/contact"}
										class="inline-block px-10 py-4 bg-primary text-white font-bold text-lg rounded-full hover:bg-neutral-900 transition-colors font-sans"
									>
										{data.midCtaSection.buttonText}
									</a>
								)
							}
						</div>
					</div>
				</section>
			)
		}

		<section class="py-24 bg-white scroll-mt-20">
			<div class="container mx-auto px-6 content-width">
				<div class="text-center mb-16">
					<h3
						class="text-3xl md:text-5xl font-bold text-neutral-900 mb-6 font-display font-syne"
					>
						{faqTitle}
					</h3>
					{
						faqSubtitle && (
							<p class="text-neutral-600 mb-4 font-sans">{faqSubtitle}</p>
						)
					}
					<div class="w-20 h-1.5 bg-primary mx-auto rounded-full">
					</div>
				</div>
				<div class="space-y-4">
					{
						data.faqs.map((faq) => (
							<div class="group border border-neutral-100 rounded-3xl overflow-hidden">
								<button class="w-full p-8 text-left flex justify-between items-center bg-white">
									<span class="font-bold text-lg md:text-xl text-neutral-800 pr-8 font-display">
										{faq.question}
									</span>
									<span class="w-8 h-8 rounded-full bg-neutral-100 flex items-center justify-center text-primary">
										<svg
											class="w-4 h-4"
											fill="none"
											stroke="currentColor"
											viewBox="0 0 24 24"
										>
											<path
												d="M19 9l-7 7-7-7"
												stroke-width="2.5"
												stroke-linecap="round"
												stroke-linejoin="round"
											/>
										</svg>
									</span>
								</button>
								<div class="max-h-0 overflow-hidden group-focus-within:max-h-96">
									<div class="px-8 pb-8 pt-0">
										<p class="text-neutral-600 leading-relaxed text-lg font-sans">
											{faq.answer}
										</p>
									</div>
								</div>
							</div>
						))
					}
				</div>
			</div>
		</section>

		<section class="py-24 bg-primary relative overflow-hidden text-center">
			<div
				class="absolute inset-0 bg-[radial-gradient(circle_at_center,rgba(255,255,255,0.1),transparent)]"
			>
			</div>
			<div class="container mx-auto px-6 relative z-10">
				<h2
					class="text-4xl md:text-6xl font-bold text-white mb-8 font-display"
				>
					{data.ctaSection.title}
				</h2>
				<p
					class="text-xl text-white/90 mb-12 content-width mx-auto leading-relaxed font-sans"
				>
					{data.ctaSection.description}
				</p>
				<a
					href={data.ctaSection.buttonLink}
					class="inline-block px-12 py-6 bg-white text-primary font-bold text-xl rounded-full font-sans"
				>
					{data.ctaSection.buttonText}
