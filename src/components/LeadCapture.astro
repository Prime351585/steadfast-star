---
---
<section id="lead-capture" class="py-24 bg-white relative">
    <div class="container mx-auto px-6">
        <div class="grid lg:grid-cols-2 gap-16 items-center">
            <!-- Lead Capture Form Side -->
            <div>
                <h2 class="text-3xl md:text-5xl font-bold mb-6 text-neutral-900">
                    Get Your Free Digital Marketing Audit
                </h2>
                <p class="text-lg text-neutral-600 mb-8 border-l-4 border-primary pl-4">
                    Our experts will analyze your current digital presence and provide a customized growth plan.
                </p>
                
                <form id="leadCaptureForm" class="space-y-6">
                    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                        <div>
                            <label class="block text-sm font-semibold text-neutral-700 mb-2">First Name</label>
                            <input type="text" id="firstName" class="w-full px-4 py-3 rounded-xl border border-neutral-300 focus:border-primary focus:ring-2 focus:ring-primary/20 outline-none transition-all" placeholder="John" required />
                        </div>
                        <div>
                            <label class="block text-sm font-semibold text-neutral-700 mb-2">Last Name</label>
                            <input type="text" id="lastName" class="w-full px-4 py-3 rounded-xl border border-neutral-300 focus:border-primary focus:ring-2 focus:ring-primary/20 outline-none transition-all" placeholder="Doe" required />
                        </div>
                    </div>
                    
                    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                        <div>
                            <label class="block text-sm font-semibold text-neutral-700 mb-2">Email Address</label>
                            <input type="email" id="email" class="w-full px-4 py-3 rounded-xl border border-neutral-300 focus:border-primary focus:ring-2 focus:ring-primary/20 outline-none transition-all" placeholder="john@company.com" required />
                        </div>
                        <div>
                            <label class="block text-sm font-semibold text-neutral-700 mb-2">Phone Number</label>
                            <input type="tel" id="phone" class="w-full px-4 py-3 rounded-xl border border-neutral-300 focus:border-primary focus:ring-2 focus:ring-primary/20 outline-none transition-all" placeholder="+91 98765 43210" required />
                        </div>
                    </div>
                    
                    <div>
                        <label class="block text-sm font-semibold text-neutral-700 mb-2">Company Website</label>
                        <input type="url" id="website" class="w-full px-4 py-3 rounded-xl border border-neutral-300 focus:border-primary focus:ring-2 focus:ring-primary/20 outline-none transition-all" placeholder="https://www.yourwebsite.com" />
                    </div>
                    
                    <div>
                        <label class="block text-sm font-semibold text-neutral-700 mb-2">What is your biggest marketing challenge?</label>
                        <textarea id="challenge" class="w-full px-4 py-3 rounded-xl border border-neutral-300 focus:border-primary focus:ring-2 focus:ring-primary/20 outline-none transition-all h-32 resize-none" placeholder="Tell us about your goals..."></textarea>
                    </div>
                    
                    <button type="submit" class="w-full py-4 bg-primary text-white font-bold rounded-xl hover:bg-neutral-900 transition-colors text-lg shadow-lg hover:shadow-xl">
                        Request Free Audit
                    </button>
                    <p class="text-xs text-center text-neutral-500 mt-4">We respect your privacy. No spam, ever.</p>
                </form>
            </div>
            
            <!-- WhatsApp Chat Strategy CTA -->
            <div class="bg-[#05211d] rounded-3xl p-8 shadow-2xl text-white relative h-full flex flex-col justify-center">
                <div class="flex items-center gap-3 mb-6">
                    <div class="flex items-center gap-2 bg-white/10 px-3 py-1.5 rounded-full">
                        <div class="w-2 h-2 rounded-full bg-red-500 animate-pulse"></div>
                        <span class="text-xs font-semibold text-white/90">LIVE NOW</span>
                    </div>
                    <span class="text-sm text-white/60">14 visitors chatting &bull; Avg. reply: 1m 47s</span>
                </div>

                <h2 class="text-3xl xl:text-4xl font-bold mb-4">Talk to a senior strategist <span class="text-green-400">right now</span></h2>
                <p class="text-white/70 mb-8 text-lg">Tap anyone below to chat instantly on WhatsApp. Real experts, real answers &mdash; no forms, no wait.</p>

                <div class="grid grid-cols-1 gap-4 mb-10 relative z-10 font-sans">
                    <!-- Profile 1 -->
                    <div class="bg-[#0a2e28] border border-white/5 rounded-2xl p-5 hover:bg-white/10 transition-colors">
                        <div class="flex items-center justify-between mb-4">
                            <div class="flex items-center gap-4">
                                <div class="w-12 h-12 rounded-full bg-green-500 flex items-center justify-center text-lg font-bold relative shrink-0 text-white">
                                    G
                                    <div class="absolute bottom-0 right-0 w-3 h-3 bg-green-400 border-2 border-[#0a2e28] rounded-full"></div>
                                </div>
                                <div>
                                    <h4 class="text-base font-bold text-white">Gurpreet S.</h4>
                                    <p class="text-xs text-white/50">SEO Expert &bull; 12 yrs</p>
                                </div>
                            </div>
                            <div class="text-green-400 text-xs font-medium flex items-center gap-1">
                                <span class="animate-bounce">&bull;</span><span class="animate-bounce" style="animation-delay: 0.1s">&bull;</span><span class="animate-bounce" style="animation-delay: 0.2s">&bull;</span> Typing...
                            </div>
                        </div>
                        <a href="https://wa.me/919211667489" target="_blank" rel="noopener noreferrer" class="flex items-center justify-center w-full py-2.5 bg-[#25D366] text-center rounded-xl font-bold hover:bg-[#1da851] transition-colors text-white text-sm">
                            <svg class="w-5 h-5 mr-2" fill="currentColor" viewBox="0 0 24 24"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51a12.8 12.8 0 0 0-.57-.01c-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 0 1-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 0 1-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 0 1 2.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0 0 12.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 0 0 5.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 0 0-3.48-8.413Z"/></svg>
                            Chat now
                        </a>
                    </div>
                </div>

                <div class="relative mb-8">
                    <div class="absolute inset-0 flex items-center">
                        <div class="w-full border-t border-white/10"></div>
                    </div>
                    <div class="relative flex justify-center">
                        <span class="bg-[#05211d] px-4 text-[10px] font-bold text-white/40 tracking-widest uppercase">OR SCHEDULE FOR LATER</span>
                    </div>
                </div>

                <div class="bg-white/5 border border-white/10 rounded-2xl p-5 flex items-center justify-between gap-4 hover:bg-white/10 transition-colors mb-6">
                    <div class="flex items-center gap-3">
                        <div class="w-10 h-10 rounded-lg bg-[#eb5a3d]/10 flex items-center justify-center text-[#eb5a3d] shrink-0">
                            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"></path></svg>
                        </div>
                        <div>
                            <h4 class="text-base font-bold text-white">Book a 30-min strategy call</h4>
                            <p class="text-white/50 text-xs"><span class="text-white/80 font-semibold">Only 5 slots</span> available today</p>
                        </div>
                    </div>
                    <a href="#lead-capture" class="px-5 py-2.5 bg-[#eb5a3d] hover:bg-[#d44d32] text-white font-bold rounded-lg transition-colors whitespace-nowrap text-sm">
                        Pick a time &rarr;
                    </a>
                </div>

                <div class="pt-4 flex items-center justify-between text-xs text-white/40 border-t border-white/10">
                    <div class="flex items-center gap-3 font-medium">
                        <span class="text-yellow-400">&starf; <span class="text-white/90">4.9</span></span>
                        <span>200+ reviews</span>
                        <span class="hidden sm:inline">22+ years</span>
                    </div>
                    <div class="flex items-center gap-1.5">
                        <svg class="w-3.5 h-3.5 text-green-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path></svg>
                        End-to-end encrypted
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

<script>
    const form = document.getElementById('leadCaptureForm');
    if (form) {
        form.addEventListener('submit', function(e) {
            e.preventDefault();
            
            const firstName = (document.getElementById('firstName') as HTMLInputElement)?.value || '';
            const lastName = (document.getElementById('lastName') as HTMLInputElement)?.value || '';
            const email = (document.getElementById('email') as HTMLInputElement)?.value || '';
            const phone = (document.getElementById('phone') as HTMLInputElement)?.value || '';
            const website = (document.getElementById('website') as HTMLInputElement)?.value || '';
            const challenge = (document.getElementById('challenge') as HTMLTextAreaElement)?.value || '';
            
            const message = `Hello! I'm requesting a Free Digital Marketing Audit.

*Name:* ${firstName} ${lastName}
*Email:* ${email}
*Phone:* ${phone}
*Website:* ${website || 'Not provided'}

*Biggest Challenge:*
${challenge || 'Not provided'}`;

            const encodedMessage = encodeURIComponent(message);
            const whatsappUrl = `https://wa.me/919211667489?text=${encodedMessage}`;
            
            window.open(whatsappUrl, '_blank');
        });
    }
</script>