---
import { Image } from "astro:assets";
import whyUsImage from "../assets/canva_assets/1.png";
---

<section class="py-24 bg-neutral-900 text-white overflow-hidden">
    <div class="container mx-auto px-6">
        <div class="text-center mb-16">
            <div
                class="grid grid-cols-1 md:grid-cols-5 gap-8 items-center text-centre md:text-left"
            >
                <div class="md:col-span-4">
                    <h2 class="text-3xl md:text-5xl font-bold mb-4">
                        Why Choose Craft Presence as Your Digital Marketing
                        Partner in India?
                    </h2>
                    <h3 class="text-xl text-primary font-medium tracking-wide">
                        Proven Expertise. Measurable Results. Trusted by
                        Businesses Across India.
                    </h3>
                </div>
                <Image
                    src={whyUsImage}
                    alt="Why Choose Us Image"
                    width={300}
                    height={300}
                    format="webp"
                    class="hidden md:block w-full h-auto col-span-1"
                />
            </div>
        </div>
        <div
            class="grid
                grid-cols-1
                md:grid-cols-2
                lg:grid-cols-4
                gap-6"
        >
            <!-- Item 1 -->
            <div class="p-6 rounded-2xl bg-white/5 border border-white/5">
                <h4 class="text-xl font-bold mb-3 text-primary">
                    AI-Powered Digital Marketing Strategies for Growth
                </h4>
                <p class="text-neutral-400 text-sm">
                    We leverage AI to drive aggressive, measurable, and scalable
                    growth.
                </p>
            </div>

            <!-- Item 2 -->
            <div class="p-6 rounded-2xl bg-white/5 border border-white/5">
                <h4 class="text-xl font-bold mb-3 text-primary">
                    Proven Digital Marketing Expertise
                </h4>
                <p class="text-neutral-400 text-sm">
                    3+ years of experience delivering measurable results across
                    20+ industries.
                </p>
            </div>

            <!-- Item 3 -->
            <div class="p-6 rounded-2xl bg-white/5 border border-white/5">
                <h4 class="text-xl font-bold mb-3 text-primary">
                    Expert-Led Execution Team
                </h4>
                <p class="text-neutral-400 text-sm">
                    Each campaign is managed by senior specialists with speed,
                    accountability, and precision.
                </p>
            </div>

            <!-- Item 4 -->
            <div class="p-6 rounded-2xl bg-white/5 border border-white/5">
                <h4 class="text-xl font-bold mb-3 text-primary">
                    Growth Partnerships, Not Vendors
                </h4>
                <p class="text-neutral-400 text-sm">
                    Craft Presence acts as a strategic growth partner, not just
                    a service provider.
                </p>
            </div>

            <!-- Item 5 -->
            <div class="p-6 rounded-2xl bg-white/5 border border-white/5">
                <h4 class="text-xl font-bold mb-3 text-primary">
                    Transparent Reporting & Communication
                </h4>
                <p class="text-neutral-400 text-sm">
                    Clear reports, honest updates, and full visibility into
                    performance and progress.
                </p>
            </div>

            <!-- Item 6 -->
            <div class="p-6 rounded-2xl bg-white/5 border border-white/5">
                <h4 class="text-xl font-bold mb-3 text-primary">
                    Trusted by 300+ Brands Across India
                </h4>
                <p class="text-neutral-400 text-sm">
                    Businesses of all sizes in India rely on us for consistent
                    results, strategic guidance, and long-term growth.
                </p>
            </div>

            <!-- Item 7 -->
            <div class="p-6 rounded-2xl bg-white/5 border border-white/5">
                <h4 class="text-xl font-bold mb-3 text-primary">
                    Complete Support From A Dedicated Team
                </h4>
                <p class="text-neutral-400 text-sm">
                    Our account managers, SEO and PPC experts, designers, and
                    developers work together to achieve results.
                </p>
            </div>

            <!-- Item 8 -->
            <div class="p-6 rounded-2xl bg-white/5 border border-white/5">
                <h4 class="text-xl font-bold mb-3 text-primary">
                    Customised Strategies for Every Business
                </h4>
                <p class="text-neutral-400 text-sm">
                    We tailor each digital campaign to match your unique goals
                    and target audience.
                </p>
            </div>
        </div>
    </div>
</section>
