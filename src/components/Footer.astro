---
import { Image } from "astro:assets";
import logoWhite from "../assets/Logo_with_text_white.png";
---

<footer class="bg-neutral-950 text-white py-12 border-t border-white/10">
    <div class="container mx-auto px-6">
        <div class="grid md:grid-cols-4 gap-8 mb-12">
            <div class="col-span-1 md:col-span-2">
                <a href="/" class="block w-48 mb-6">
                    <Image
                        src={logoWhite}
                        alt="Craft Presence"
                        class="w-full h-auto"
                    />
                </a>
                <p class="text-neutral-400 max-w-sm">
                    Crafting digital experiences that leave a lasting
                    impression. We help businesses grow through innovative web
                    solutions and strategic marketing.
                </p>
            </div>
            <div>
                <h4 class="font-bold text-lg mb-4">Services</h4>
                <ul class="space-y-2 text-neutral-400">
                    <li>
                        <a
                            href="/services/web-development"
                            class="hover:text-primary">Web Development</a
                        >
                    </li>
                    <li>
                        <a
                            href="/services/digital-marketing"
                            class="hover:text-primary">Digital Marketing</a
                        >
                    </li>
                    <li>
                        <a
                            href="/services/seo-services"
                            class="hover:text-primary">SEO Services</a
                        >
                    </li>
                    <li>
                        <a href="/services/branding" class="hover:text-primary"
                            >Branding</a
                        >
                    </li>
                    <li>
                        <a
                            href="/services/ecommerce-development"
                            class="hover:text-primary">Ecommerce</a
                        >
                    </li>
                </ul>
            </div>
            <div>
                <h4 class="font-bold text-lg mb-4">Company</h4>
                <ul class="space-y-2 text-neutral-400">
                    <li>
                        <a href="/about" class="hover:text-primary">About Us</a>
                    </li>
                    <li>
                        <a href="/contact" class="hover:text-primary">Contact</a
                        >
                    </li>
                    <li>
                        <a href="#" class="hover:text-primary">Privacy Policy</a
                        >
                    </li>
                    <li>
                        <a href="#" class="hover:text-primary"
                            >Terms of Service</a
                        >
                    </li>
                </ul>
            </div>
        </div>
        <div
            class="pt-8 border-t border-white/10 flex flex-col md:flex-row justify-between items-center gap-4 text-neutral-500 text-sm"
        >
            <p>
                &copy; {new Date().getFullYear()} Craft Presence. All rights reserved.
            </p>
            <div class="flex gap-6">
                <a href="#" class="hover:text-white">Twitter</a>
                <a href="#" class="hover:text-white">LinkedIn</a>
                <a href="#" class="hover:text-white">Instagram</a>
            </div>
        </div>
    </div>
</footer>
