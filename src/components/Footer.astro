---
import { Image } from "astro:assets";
import logoWhite from "../assets/Logo_with_text_white.png";
---

<footer class="bg-neutral-950 text-white py-12 border-t border-white/10">
    <div class="container mx-auto px-6">
        <div class="grid md:grid-cols-4 gap-8 mb-12">
            <div class="col-span-1 md:col-span-2">
                <a href="/" class="block w-48 mb-6">
                    <Image
                        src={logoWhite}
                        alt="Craft Presence"
                        class="w-full h-auto"
                    />
                </a>
                <p class="text-neutral-400 max-w-sm">
                    Crafting digital experiences that leave a lasting
                    impression. We help businesses grow through innovative web
                    solutions and strategic marketing.
                </p>
            </div>
            <div>
                <h4 class="font-bold text-lg mb-4">Services</h4>
                <ul class="space-y-2 text-neutral-400">
                    <li>
                        <a
                            href="/services/web-development"
                            class="hover:text-primary transition-colors"
                            >Web Development</a>
                    </li>
                    <li>
                        <a
                            href="/services/digital-marketing"
                            class="hover:text-primary transition-colors"
                            >Digital Marketing</a>
                    </li>
                    <li>
                        <a
                            href="/services/local-seo"
                            class="hover:text-primary transition-colors"
                            >Local SEO</a>
                    </li>
                    <li>
                        <a
                            href="/services/branding"
                            class="hover:text-primary transition-colors"
                            >Branding</a>
                    </li>
                    <li>
                        <a
                            href="/services/ecommerce"
                            class="hover:text-primary transition-colors"
                            >Ecommerce</a>
                    </li>
                </ul>
            </div>
            <div>
                <h4 class="font-bold text-lg mb-4">Company</h4>
                <ul class="space-y-2 text-neutral-400">
                    <li>
                        <a
                            href="/about"
                            class="hover:text-primary transition-colors"
                            >About Us</a>
                    </li>
                    <li>
                        <a
                            href="/contact"
                            class="hover:text-primary transition-colors"
                            >Contact</a>
                    </li>
                    <li>
                        <a href="#" class="hover:text-primary transition-colors"
                            >Privacy Policy</a>
                    </li>
                    <li>
                        <a href="#" class="hover:text-primary transition-colors"
                            >Terms of Service</a>
                    </li>
                </ul>
            </div>
        </div>
        <div
            class="pt-8 border-t border-white/10 flex flex-col md:flex-row justify-between items-center gap-4 text-neutral-500 text-sm"
        >
            <p>
                &copy; {new Date().getFullYear()} Craft Presence. All rights reserved.
            </p>
            <div class="flex gap-6">
                <a href="#" class="hover:text-white transition-colors"
                    >Twitter</a
                >
                <a href="#" class="hover:text-white transition-colors"
                    >LinkedIn</a
                >
                <a href="#" class="hover:text-white transition-colors"
                    >Instagram</a
                >
            </div>
        </div>
    </div>
</footer>
