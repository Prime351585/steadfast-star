---
interface Props {
    title: string;
    subtitle?: string;
}

const { title, subtitle } = Astro.props;
---

<section class="relative pt-32 pb-20 bg-neutral-950 overflow-hidden">
    <!-- Background decoration -->
    <div class="absolute inset-0 overflow-hidden pointer-events-none">
        <div
            class="absolute top-0 left-1/4 w-96 h-96 bg-primary/10 rounded-full blur-3xl"
        >
        </div>
        <div
            class="absolute bottom-0 right-1/4 w-96 h-96 bg-primary/5 rounded-full blur-3xl"
        >
        </div>
    </div>

    <div class="container mx-auto px-6 relative z-10 text-center">
        <h1 class="text-4xl md:text-6xl font-bold font-display text-white mb-6">
            {title}
        </h1>
        {
            subtitle && (
                <p class="text-xl text-neutral-400 content-width mx-auto">
                    {subtitle}
                </p>
            )
        }
    </div>
</section>
