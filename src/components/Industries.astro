---
const industries = [
    "Real Estate",
    "Ecommerce",
    "Dental Clinic",
    "Automotive",
    "Healthcare",
    "Construction Company",
    "Law Firm",
    "Home Improvement",
    "Plumbing",
    "HVAC Services",
    "Restaurants",
    "Pest Control",
    "Photography",
    "Financial Services",
    "Education",
    "Accountants",
    "Travel & Tourism",
    "Manufacturing Companies",
    "Hospitality & Hotel",
    "Startups",
    "Cleaning Company"
];
---

<section class="py-24 text-white bg-neutral-950">
    <div class="container mx-auto px-6">
        <div class="text-center max-w-3xl mx-auto mb-16">
            <h3 class="text-3xl md:text-5xl font-bold mb-6">
                Which industries does Craft Presence serve in India?
            </h3>
            <p class="text-neutral-400 text-lg">
                We deliver digital marketing strategies across multiple industries in India, with campaign approaches tailored to each sector's buyer journey, compliance requirements, and conversion patterns.
            </p>
        </div>

        <div class="flex flex-wrap justify-center gap-4">
            {
                industries.map((industry) => (
                    <div class="px-8 py-4 bg-neutral-50 rounded-full border border-neutral-100 font-medium text-neutral-700 cursor-default">
                        {industry}
                    </div>
                ))
            }
        </div>
    </div>
</section>
