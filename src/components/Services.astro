---
import type { HomepageContent } from "../data/homepage/types";

interface Props {
	content: HomepageContent["services"];
}

const { content } = Astro.props;
---

<section id="services" class="py-24 bg-white relative overflow-hidden">
  <div class="container mx-auto px-6">
    <div class="text-center content-width mx-auto mb-16">
      <h2 class="text-sm font-bold text-primary tracking-widest uppercase mb-3">
        {content.eyebrow}
      </h2>
      <h3 class="text-3xl md:text-5xl font-bold text-neutral-900 mb-6">
        {content.title}
      </h3>
      <p class="text-neutral-600 text-lg">
        {content.intro}
      </p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
      {
        content.items.map((service) => (
          <a href={service.href} class="block p-8 rounded-3xl bg-neutral-50 border border-neutral-100 hover:border-primary transition-colors">
            <div class="w-14 h-14 rounded-2xl bg-primary/10 text-primary flex items-center justify-center mb-6">
              <svg class="w-7 h-7" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"></path></svg>
            </div>
            <h4 class="text-xl font-bold text-neutral-900 mb-3">{service.title}</h4>
            <p class="text-neutral-600 leading-relaxed text-sm">
              {service.description}
            </p>
          </a>
        ))
      }
    </div>
  </div>
</section>
