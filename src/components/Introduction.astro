---
import type { HomepageContent } from "../data/homepage/types";

interface Props {
	aboutUs: HomepageContent["aboutUs"];
}

const { aboutUs } = Astro.props;
---

<section id="introduction" class="py-24 bg-white text-neutral-900">
    <div class="container mx-auto px-6">
        <div class="content-width mx-auto text-center">
            <h2 class="text-3xl md:text-4xl font-bold mb-8">About Us</h2>
            <div class="space-y-6 text-left mx-auto">
                {aboutUs.paragraphs.map((paragraph) => (
                    <p class="text-lg md:text-xl text-neutral-700 leading-relaxed">
                        {paragraph}
                    </p>
                ))}
                {aboutUs.citiesLine && (
                    <div class="mt-6">
                        <p class="text-neutral-600"><span class="font-semibold text-neutral-900">Cities we serve across India:</span> {aboutUs.citiesLine}</p>
                    </div>
                )}
            </div>
        </div>
    </div>
</section>

<section class="py-16 bg-neutral-950 relative overflow-hidden">
    <!-- Theme background grid -->
    <div class="absolute inset-0 bg-[linear-gradient(to_right,#80808012_1px,transparent_1px),linear-gradient(to_bottom,#80808012_1px,transparent_1px)] bg-[size:24px_24px]"></div>
    
    <div class="container mx-auto px-6 relative z-10">
        <h3 class="text-white text-2xl md:text-3xl font-bold mb-10 text-center">Trusted & Supported By</h3>
        
        <div class="flex flex-wrap justify-center gap-6">
            <!-- Certification 1 -->
            <div class="bg-white rounded-2xl w-[160px] h-[120px] flex flex-col items-center justify-center p-4 shadow-xl hover:-translate-y-1 transition-transform">
                <span class="font-bold text-neutral-900 text-center text-xl leading-tight cursor-default">Google<br/><span class="text-neutral-500 font-medium text-sm">Partner</span></span>
            </div>
            
            <!-- Certification 2 -->
            <div class="bg-white rounded-2xl w-[160px] h-[120px] flex flex-col items-center justify-center p-4 shadow-xl hover:-translate-y-1 transition-transform">
                <span class="font-bold text-neutral-900 text-center text-xl leading-tight cursor-default">Meta<br/><span class="text-neutral-500 font-medium text-sm">Business Partner</span></span>
            </div>
            
            <!-- Certification 3 -->
            <div class="bg-white rounded-2xl w-[160px] h-[120px] flex flex-col items-center justify-center p-4 shadow-xl hover:-translate-y-1 transition-transform">
                <span class="font-bold text-neutral-900 text-center text-xl leading-tight cursor-default">HubSpot<br/><span class="text-neutral-500 font-medium text-sm">Certified</span></span>
            </div>
            
            <!-- Certification 4 -->
            <div class="bg-white rounded-2xl w-[160px] h-[120px] flex flex-col items-center justify-center p-4 shadow-xl hover:-translate-y-1 transition-transform">
                <span class="font-bold text-neutral-900 text-center text-xl leading-tight cursor-default">SEMrush<br/><span class="text-neutral-500 font-medium text-sm">Certified</span></span>
            </div>
        </div>
    </div>
</section>
