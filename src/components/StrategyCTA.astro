---
---
<section class="py-24 bg-white relative">
    <div class="container mx-auto px-6">
        <div class="bg-[#05211d] rounded-3xl p-8 md:p-12 shadow-2xl text-white relative">
            <div class="flex items-center gap-3 mb-6">
                <div class="flex items-center gap-2 bg-white/10 px-3 py-1.5 rounded-full">
                    <div class="w-2 h-2 rounded-full bg-red-500 animate-pulse"></div>
                    <span class="text-xs font-semibold text-white/90">LIVE NOW</span>
                </div>
                <span class="text-sm text-white/60">14 visitors chatting &bull; Avg. reply: 1m 47s</span>
            </div>

            <h2 class="text-3xl md:text-5xl font-bold mb-4">Talk to a senior strategist <span class="text-green-400">right now</span></h2>
            <p class="text-white/70 mb-10 text-lg">Tap anyone below to chat instantly on WhatsApp. Real experts, real answers — no forms, no wait.</p>

            <div class="grid grid-cols-1 md:grid-cols-3 gap-6 mb-12 relative z-10">
                <!-- Profile 1 -->
                <div class="bg-white/5 border border-white/10 rounded-2xl p-6 hover:bg-white/10 transition-colors">
                    <div class="flex items-center gap-4 mb-4">
                        <div class="w-14 h-14 rounded-full bg-green-500 flex items-center justify-center text-xl font-bold relative">
                            G
                            <div class="absolute bottom-0 right-0 w-3 h-3 bg-green-400 border-2 border-neutral-900 rounded-full"></div>
                        </div>
                        <div>
                            <h4 class="text-lg font-bold">Gurpreet S.</h4>
                            <p class="text-sm text-white/60">SEO Expert &bull; 12 yrs</p>
                        </div>
                    </div>
                    <div class="text-green-400 text-sm mb-4 font-medium flex items-center gap-1">
                        <span class="animate-bounce">&bull;</span><span class="animate-bounce" style="animation-delay: 0.1s">&bull;</span><span class="animate-bounce" style="animation-delay: 0.2s">&bull;</span> Typing...
                    </div>
                    <a href="https://wa.me/91XXXXXXXXXX" target="_blank" rel="noopener noreferrer" class="block w-full py-3 bg-green-500 text-center rounded-xl font-bold shadow-lg hover:bg-green-400 transition-colors text-white">
                        <i class="fab fa-whatsapp mr-2"></i> Chat now
                    </a>
                </div>

                <!-- Profile 2 -->
                <div class="bg-white/5 border border-white/10 rounded-2xl p-6 hover:bg-white/10 transition-colors">
                    <div class="flex items-center gap-4 mb-4">
                        <div class="w-14 h-14 rounded-full bg-orange-500 flex items-center justify-center text-xl font-bold relative">
                            M
                            <div class="absolute bottom-0 right-0 w-3 h-3 bg-green-400 border-2 border-neutral-900 rounded-full"></div>
                        </div>
                        <div>
                            <h4 class="text-lg font-bold">Michal R.</h4>
                            <p class="text-sm text-white/60">AI SEO &bull; 10 yrs</p>
                        </div>
                    </div>
                    <div class="text-green-400 text-sm mb-4 font-medium flex items-center gap-2">
                        <div class="w-2 h-2 rounded-full bg-green-400"></div> Active now
                    </div>
                    <a href="https://wa.me/91XXXXXXXXXX" target="_blank" rel="noopener noreferrer" class="block w-full py-3 bg-green-500 text-center rounded-xl font-bold shadow-lg hover:bg-green-400 transition-colors text-white">
                        <i class="fab fa-whatsapp mr-2"></i> Chat now
                    </a>
                </div>

                <!-- Profile 3 -->
                <div class="bg-white/5 border border-white/10 rounded-2xl p-6 hover:bg-white/10 transition-colors">
                    <div class="flex items-center gap-4 mb-4">
                        <div class="w-14 h-14 rounded-full bg-teal-500 flex items-center justify-center text-xl font-bold relative">
                            J
                            <div class="absolute bottom-0 right-0 w-3 h-3 bg-green-400 border-2 border-neutral-900 rounded-full"></div>
                        </div>
                        <div>
                            <h4 class="text-lg font-bold">Jasmine K.</h4>
                            <p class="text-sm text-white/60">Strategy &bull; 9 yrs</p>
                        </div>
                    </div>
                    <div class="text-white/50 text-sm mb-4 font-medium flex items-center gap-2">
                        <div class="w-2 h-2 rounded-full bg-white/50"></div> Replied 2m ago
                    </div>
                    <a href="https://wa.me/91XXXXXXXXXX" target="_blank" rel="noopener noreferrer" class="block w-full py-3 bg-green-500 text-center rounded-xl font-bold shadow-lg hover:bg-green-400 transition-colors text-white">
                        <i class="fab fa-whatsapp mr-2"></i> Chat now
                    </a>
                </div>
            </div>

            <div class="relative">
                <div class="absolute inset-0 flex items-center">
                    <div class="w-full border-t border-white/10"></div>
                </div>
                <div class="relative flex justify-center">
                    <span class="bg-[#05211d] px-4 text-xs font-bold text-white/40 tracking-widest uppercase">OR SCHEDULE FOR LATER</span>
                </div>
            </div>

            <div class="mt-8 bg-white/5 border border-white/10 rounded-2xl p-6 flex flex-col sm:flex-row items-center justify-between gap-6 hover:bg-white/10 transition-colors">
                <div class="flex items-center gap-4">
                    <div class="w-12 h-12 rounded-xl bg-white/5 flex items-center justify-center text-orange-400">
                        <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"></path></svg>
                    </div>
                    <div>
                        <h4 class="text-xl font-bold">Book a 30-min strategy call</h4>
                        <p class="text-white/60 text-sm"><span class="text-white/90 font-semibold">Only 5 slots</span> available today</p>
                    </div>
                </div>
                <a href="#contact" class="px-8 py-3 bg-orange-500 hover:bg-orange-600 text-white font-bold rounded-xl shadow-lg transition-colors whitespace-nowrap">
                    Pick a time &rarr;
                </a>
            </div>

            <div class="mt-8 flex flex-col sm:flex-row items-center justify-between text-sm text-white/50 gap-4">
                <div class="flex items-center gap-4 font-medium">
                    <span class="text-yellow-400">&starf; <span class="text-white/90">4.9</span></span>
                    <span>200+ reviews</span>
                    <span>22+ years</span>
                    <span>400+ team</span>
                </div>
                <div class="flex items-center gap-2">
                    <svg class="w-4 h-4 text-green-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path></svg>
                    End-to-end encrypted
                </div>
            </div>
        </div>
    </div>
</section>