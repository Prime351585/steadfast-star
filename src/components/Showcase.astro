---
import { Image } from "astro:assets";

// Import your local images here
import dwizzyImg from "../assets/showcase/dwizzy.jpg";
import giggles from "../assets/showcase/giggles.jpg";
import maruwan from "../assets/showcase/maruwan.jpg";
import pupsncups from "../assets/showcase/pupsncups.jpg";
import vanchuhut from "../assets/showcase/vanchuhut.jpg";


const projects = [
    {
        title: "Dwizzy E-Commerce",
        category: "Web Development",
        image: dwizzyImg,
        link: "https://dwizzyinfra.com/",
        color: "bg-blue-500"
    },
    {
        title: "Pups & Cups",
        category: "Digital Marketing + Web Development",
        image: pupsncups,
        link: "https://pupsandcups.in/",
        color: "bg-emerald-500"
    },
    {
        title: "Vanchu Hut",
        category: "UI/UX Design + Web Development",
        image: vanchuhut, // Replace with actual imported image
        link: "https://vanchuhut.in/",
        color: "bg-purple-500"
    },
    {
        title: "Giggles Gifts",
        category: "Web Development & SEO",
        image: giggles, // Replace with actual imported image
        link: "https://gigglesgifts.in/",
        color: "bg-orange-500"
    },
    {
        title: "Maruwan",
        category: "Web Development",
        image: maruwan, // Replace with actual imported image
        link: "https://maruwantextile.com/",
        color: "bg-orange-500"
    },
];
---

<section id="portfolio" class="py-24 bg-neutral-50 relative overflow-hidden">
    <div class="container mx-auto px-6">
        <div class="text-center max-w-3xl mx-auto mb-16">
            <h2 class="text-sm font-bold text-primary tracking-widest uppercase mb-3">
                Selected Work
            </h2>
            <h3 class="text-3xl md:text-5xl font-bold text-neutral-900 mb-6">
                Our Portfolio Showcase
            </h3>
            <p class="text-lg text-neutral-600">
                Explore some of our recent digital success stories. From blazing-fast websites to high-converting marketing campaigns.
            </p>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-10">
            {
                projects.map((project) => (
                    <div class="group relative bg-white rounded-3xl p-4 shadow-sm hover:shadow-2xl transition-all duration-500 border border-neutral-100 flex flex-col">
                        <!-- Browser Mockup Header -->
                        <div class="flex items-center gap-2 px-4 py-3 bg-neutral-100 rounded-t-2xl border-b border-neutral-200">
                            <div class="flex gap-1.5 basis-1/4">
                                <div class="w-3 h-3 rounded-full bg-red-400"></div>
                                <div class="w-3 h-3 rounded-full bg-yellow-400"></div>
                                <div class="w-3 h-3 rounded-full bg-green-400"></div>
                            </div>
                            <div class="basis-1/2 flex justify-center">
                                <div class="bg-white px-3 py-1 rounded-md text-[10px] text-neutral-400 font-mono w-full text-center max-w-[200px] truncate">
                                    {project.link}
                                </div>
                            </div>
                        </div>

                        <!-- Content wrapper -->
                        <div class="relative overflow-hidden aspect-video bg-neutral-200">
                            <Image
                                src={project.image}
                                alt={project.title}
                                class="object-cover object-top w-full h-full transform group-hover:scale-105 transition-transform duration-700 ease-out"
                            />
                            
                            <!-- Overlay -->
                            <div class="absolute inset-0 bg-neutral-900/60 opacity-0 group-hover:opacity-100 transition-opacity duration-300 flex items-center justify-center backdrop-blur-sm">
                                <a href={project.link} class="px-6 py-3 bg-white text-neutral-900 font-bold rounded-xl transform translate-y-4 group-hover:translate-y-0 transition-all duration-300 hover:bg-primary hover:text-white flex items-center gap-2">
                                    Visit Website
                                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"></path></svg>
                                </a>
                            </div>
                        </div>

                        <!-- Footer details -->
                        <div class="p-6 pb-2">
                            <div class="flex justify-between items-center">
                                <div>
                                    <span class={`inline-block px-3 py-1 bg-neutral-100 text-neutral-600 text-xs font-bold rounded-full mb-3`}>
                                        {project.category}
                                    </span>
                                    <h4 class="text-2xl font-bold text-neutral-900 group-hover:text-primary transition-colors">
                                        {project.title}
                                    </h4>
                                </div>
                            </div>
                        </div>
                    </div>
                ))
            }
        </div>

        <div class="mt-16 text-center">
            <a
                href="#"
                class="inline-flex items-center px-8 py-4 border-2 border-primary text-primary font-bold rounded-xl hover:bg-primary hover:text-white transition-colors text-lg"
            >
                View All Case Studies
                <svg
                    class="w-5 h-5 ml-2"
                    fill="none"
                    stroke="currentColor"
                    viewBox="0 0 24 24"
                    ><path
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        stroke-width="2"
                        d="M17 8l4 4m0 0l-4 4m4-4H3"></path></svg
                >
            </a>
        </div>
    </div>
</section>
