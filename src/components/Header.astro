---
import { Image } from "astro:assets";
import logoWhite from "../assets/Logo_with_text_white.png";
import logoBlack from "../assets/Logo_with_text_black.png";

const navItems = [
    { name: "Home", href: "/" },
    { name: "About Us", href: "/about" },
    {
        name: "Services",
        href: "#",
        subItems: [
            { name: "Web Development", href: "/services/web-development" },
            { name: "Digital Marketing", href: "/services/digital-marketing" },
            { name: "SEO Services", href: "/services/seo-services" },
            {
                name: "Mobile App Development",
                href: "/services/mobile-app-development",
            },
            { name: "Branding", href: "/services/branding" },
            { name: "Ecommerce", href: "/services/ecommerce-development" },
        ],
    },
    { name: "Contact", href: "/contact" },
];
---

<header
    class="fixed top-6 left-1/2 -translate-x-1/2 w-[95%] max-w-6xl z-50"
    id="main-header"
>
    <div
        class="bg-neutral-900/80 backdrop-blur-xl border border-white/10 rounded-full px-6 py-3 flex justify-between items-center shadow-2xl shadow-black/20"
    >
        <a href="/" class="relative block w-32 shrink-0">
            <Image
                src={logoWhite}
                alt="Craft Presence"
                class="w-full h-auto object-contain"
            />
        </a>

        <!-- Desktop Menu -->
        <nav class="hidden md:flex items-center gap-1">
            {
                navItems.map((item) =>
                    item.subItems ? (
                        <div class="relative group px-3 py-2">
                            <button class="flex items-center gap-1 text-sm font-medium text-neutral-300 hover:text-white">
                                {item.name}
                                <svg
                                    class="w-3.5 h-3.5 opacity-50 group-hover:opacity-100"
                                    fill="none"
                                    stroke="currentColor"
                                    viewBox="0 0 24 24"
                                >
                                    <path
                                        stroke-linecap="round"
                                        stroke-linejoin="round"
                                        stroke-width="2"
                                        d="M19 9l-7 7-7-7"
                                    />
                                </svg>
                            </button>
                            <div class="absolute top-full left-1/2 -translate-x-1/2 pt-4 opacity-0 invisible group-hover:opacity-100 group-hover:visible">
                                <div class="bg-neutral-900 border border-white/10 rounded-2xl overflow-hidden shadow-2xl p-2 w-64 ring-1 ring-white/5">
                                    {item.subItems.map((subItem) => (
                                        <a
                                            href={subItem.href}
                                            class="block px-4 py-3 text-sm text-neutral-400 hover:text-white hover:bg-white/5 rounded-xl"
                                        >
                                            {subItem.name}
                                        </a>
                                    ))}
                                </div>
                            </div>
                        </div>
                    ) : (
                        <a
                            href={item.href}
                            class="px-5 py-2 text-sm font-medium text-neutral-300 hover:text-white"
                        >
                            {item.name}
                        </a>
                    ),
                )
            }
        </nav>

        <div class="flex items-center gap-4">
            <a
                href="tel:+919999999999"
                class="hidden md:flex items-center gap-2 text-sm font-medium text-neutral-300 hover:text-white"
            >
                <!-- Phone Icon -->
                <svg
                    class="w-4 h-4"
                    fill="none"
                    viewBox="0 0 24 24"
                    stroke="currentColor"
                >
                    <path
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        stroke-width="2"
                        d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"
                    ></path>
                </svg>
                <span class="hidden lg:inline">Request Callback</span>
            </a>
            <a
                href="#contact"
                class="bg-white text-neutral-950 px-6 py-2.5 rounded-full text-sm font-semibold hover:bg-neutral-200 shadow-lg shadow-white/10 hidden sm:block"
            >
                Get Started
            </a>

            <!-- Mobile Phone Button -->
            <a
                href="tel:+919999999999"
                class="md:hidden flex items-center justify-center w-10 h-10 rounded-full bg-white/10 text-white border border-white/10"
                aria-label="Request Callback"
            >
                <svg
                    class="w-5 h-5"
                    fill="none"
                    viewBox="0 0 24 24"
                    stroke="currentColor"
                >
                    <path
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        stroke-width="2"
                        d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"
                    ></path>
                </svg>
            </a>

            <!-- Mobile Menu Button -->
            <button
                id="menu-toggle"
                class="md:hidden z-50 relative w-10 h-10 flex flex-col justify-center items-center gap-1.5 group cursor-pointer ml-2"
            >
                <span
                    class="w-5 h-0.5 bg-white group-[.active]:rotate-45 group-[.active]:translate-y-2"
                ></span>
                <span class="w-5 h-0.5 bg-white group-[.active]:opacity-0"
                ></span>
                <span
                    class="w-5 h-0.5 bg-white group-[.active]:-rotate-45 group-[.active]:-translate-y-2"
                ></span>
            </button>
        </div>

        <!-- Mobile Menu Overlay -->
        <div
            id="mobile-menu"
            class="fixed inset-0 bg-neutral-950 z-40 translate-x-full flex flex-col justify-center items-center gap-8 md:hidden overflow-y-auto w-screen h-screen top-[-24px] left-[50%] ml-[-50vw]"
        >
            {
                navItems.map((item) =>
                    item.subItems ? (
                        <div class="flex flex-col items-center gap-4">
                            <span class="text-sm font-bold text-neutral-500 uppercase tracking-widest">
                                {item.name}
                            </span>
                            {item.subItems.map((subItem) => (
                                <a
                                    href={subItem.href}
                                    class="mobile-link text-2xl font-bold text-white hover:text-primary"
                                >
                                    {subItem.name}
                                </a>
                            ))}
                        </div>
                    ) : (
                        <a
                            href={item.href}
                            class="mobile-link text-3xl font-bold text-white hover:text-primary"
                        >
                            {item.name}
                        </a>
                    ),
                )
            }
            <a
                href="#contact"
                class="mobile-link mt-8 bg-white text-neutral-950 px-8 py-4 rounded-full text-lg font-bold hover:bg-neutral-200"
            >
                Start Your Project
            </a>
        </div>
    </div>
</header>

<script>
    const header = document.getElementById("main-header");
    const menuToggle = document.getElementById("menu-toggle");
    const mobileMenu = document.getElementById("mobile-menu");
    const mobileLinks = document.querySelectorAll(".mobile-link");

    // Mobile menu toggle
    menuToggle?.addEventListener("click", () => {
        menuToggle.classList.toggle("active");
        mobileMenu?.classList.toggle("translate-x-full");
        document.body.classList.toggle("overflow-hidden");
    });

    // Close mobile menu on link click
    mobileLinks.forEach((link) => {
        link.addEventListener("click", () => {
            menuToggle?.classList.remove("active");
            mobileMenu?.classList.add("translate-x-full");
            document.body.classList.remove("overflow-hidden");
        });
    });
</script>
