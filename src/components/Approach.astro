---
import { Image } from "astro:assets";
import ApproachImage from "../assets/canva_assets/C2.png";
const steps = [
    {
        number: "01",
        title: "Understanding Your Business Goals",
        description:
            "Before we start designing, we learn about your small business, its services, and what makes it unique. That insight helps us create a website that truly reflects your purpose and vision.",
    },
    {
        number: "02",
        title: "Planning the Perfect Layout",
        description:
            "A great website starts with structure. We build layouts that make your story clear and lead people to take the next step, whether that's calling, booking, or buying.",
    },
    {
        number: "03",
        title: "Crafting Messaging That Connects",
        description:
            "We shape your content around what your customers care about most. Every word is chosen to highlight your strengths, build trust, and show why your business is the right choice.",
    },
    {
        number: "04",
        title: "Designing Visuals That Represent You",
        description:
            "Your brand deserves a look that feels professional and personal at the same time. We use visuals, colours, and fonts that make your website warm, memorable, and aligned with your identity.",
    },
    {
        number: "05",
        title: "Creating Calls-to-Action That Convert",
        description:
            "From 'Book Now' to 'Get a Free Quote,' every button is placed with purpose. We make it easy for people who visit your site to find their way around, so that interest turns into action and leads.",
    },
    {
        number: "06",
        title: "Building Fast, Secure, and SEO-Friendly Websites",
        description:
            "Your website will look great on every screen and load fast every time. With expert optimisation and smart structure, our small business website design approach helps you rank better and convert more.",
    },
];
---

<section
    id="approach"
    class="py-24 bg-neutral-950 text-white relative overflow-hidden"
>
    <!-- Background decoration -->
    <div
        class="absolute top-0 left-0 w-full h-full overflow-hidden pointer-events-none"
    >
        <div
            class="absolute top-1/4 -left-64 w-96 h-96 bg-primary/20 rounded-full blur-3xl"
        >
        </div>
        <div
            class="absolute bottom-1/4 -right-64 w-96 h-96 bg-primary/10 rounded-full blur-3xl"
        >
        </div>
    </div>

    <div class="container mx-auto px-6 relative z-10">
        <div class="flex flex-col md:flex-row gap-12 md:gap-16 items-start">
            <div class="w-full md:w-1/3 sticky top-32 text-center md:text-left">
                <h2
                    class="text-sm font-bold text-primary tracking-widest uppercase mb-3"
                >
                    Our Approach
                </h2>
                <h3 class="text-4xl md:text-5xl font-bold mb-6">
                    How We Make It Happen
                </h3>
                <p class="text-neutral-400 text-lg leading-relaxed">
                    Our proven process ensures that every project is delivered
                    on time, within budget, and exceeds expectations. We believe
                    in transparency and collaboration at every step.
                </p>
                <Image
                    src={ApproachImage}
                    width={400}
                    height={400}
                    alt={"How Craft Presence approach problems"}
                    class="w-full h-full mt-40 hidden md:block"
                />

                <!-- Mobile Scroll Indicator -->
                <div class="flex md:hidden justify-center gap-2">
                    <div class="w-2 h-2 rounded-full bg-primary animate-pulse">
                    </div>
                    <div class="w-2 h-2 rounded-full bg-white/20"></div>
                    <div class="w-2 h-2 rounded-full bg-white/20"></div>
                </div>
            </div>

            <div class="w-full md:w-2/3 mt-22">
                <div
                    class="flex md:flex-col gap-6 overflow-x-auto md:overflow-visible snap-x snap-mandatory pb-8 md:pb-0 -mx-6 px-6 md:mx-0 md:px-0 scrollbar-hide"
                >
                    {
                        steps.map((step) => (
                            <div class="min-w-[85vw] md:min-w-0 snap-center flex flex-col md:flex-row gap-6 p-8 rounded-3xl bg-white/5 border border-white/5 backdrop-blur-sm">
                                <span class="text-6xl md:text-5xl font-bold text-white/10">
                                    {step.number}
                                </span>
                                <div>
                                    <h4 class="text-2xl font-bold mb-3">
                                        {step.title}
                                    </h4>
                                    <p class="text-neutral-400 leading-relaxed">
                                        {step.description}
                                    </p>
                                </div>
                            </div>
                        ))
                    }
                </div>
            </div>
        </div>
    </div>
</section>

<style>
    .scrollbar-hide::-webkit-scrollbar {
        display: none;
    }
    .scrollbar-hide {
        -ms-overflow-style: none;
        scrollbar-width: none;
    }
</style>
