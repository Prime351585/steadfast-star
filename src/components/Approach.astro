---
const steps = [
    {
        number: "01",
        title: "Discovery",
        description:
            "We dive deep into your business goals and target audience.",
    },
    {
        number: "02",
        title: "Strategy",
        description:
            "We craft a tailored roadmap to achieve your digital objectives.",
    },
    {
        number: "03",
        title: "Design",
        description: "We create visually stunning and intuitive interfaces.",
    },
    {
        number: "04",
        title: "Development",
        description:
            "We build robust, scalable, and high-performance solutions.",
    },
    {
        number: "05",
        title: "Launch",
        description:
            "We deploy your project and ensure a smooth go-live experience.",
    },
];
---

<section
    id="approach"
    class="py-24 bg-neutral-950 text-white relative overflow-hidden"
>
    <!-- Background decoration -->
    <div
        class="absolute top-0 left-0 w-full h-full overflow-hidden pointer-events-none"
    >
        <div
            class="absolute top-1/4 -left-64 w-96 h-96 bg-primary/20 rounded-full blur-3xl"
        >
        </div>
        <div
            class="absolute bottom-1/4 -right-64 w-96 h-96 bg-primary/10 rounded-full blur-3xl"
        >
        </div>
    </div>

    <div class="container mx-auto px-6 relative z-10">
        <div class="flex flex-col md:flex-row gap-12 md:gap-16 items-start">
            <div class="w-full md:w-1/3 sticky top-32 text-center md:text-left">
                <h2
                    class="text-sm font-bold text-primary tracking-widest uppercase mb-3"
                >
                    Our Approach
                </h2>
                <h3 class="text-4xl md:text-5xl font-bold mb-6">
                    How We Make It Happen
                </h3>
                <p class="text-neutral-400 text-lg leading-relaxed">
                    Our proven process ensures that every project is delivered
                    on time, within budget, and exceeds expectations. We believe
                    in transparency and collaboration at every step.
                </p>

                <!-- Mobile Scroll Indicator -->
                <!-- <div class="flex md:hidden justify-center gap-2">
                    <div class="w-2 h-2 rounded-full bg-primary animate-pulse">
                    </div>
                    <div class="w-2 h-2 rounded-full bg-white/20"></div>
                    <div class="w-2 h-2 rounded-full bg-white/20"></div>
                </div> -->
            </div>

            <div class="w-full md:w-2/3 mt-22">
                <div
                    class="flex md:flex-col gap-6 overflow-x-auto md:overflow-visible snap-x snap-mandatory pb-8 md:pb-0 -mx-6 px-6 md:mx-0 md:px-0 scrollbar-hide"
                >
                    {
                        steps.map((step) => (
                            <div class="min-w-[85vw] md:min-w-0 snap-center flex flex-col md:flex-row gap-6 p-8 rounded-3xl bg-white/5 hover:bg-white/10 border border-white/5 transition-all duration-300 group backdrop-blur-sm">
                                <span class="text-6xl md:text-5xl font-bold text-white/10 group-hover:text-primary/50 transition-colors duration-300">
                                    {step.number}
                                </span>
                                <div>
                                    <h4 class="text-2xl font-bold mb-3 group-hover:text-primary transition-colors duration-300">
                                        {step.title}
                                    </h4>
                                    <p class="text-neutral-400 leading-relaxed">
                                        {step.description}
                                    </p>
                                </div>
                            </div>
                        ))
                    }
                </div>
            </div>
        </div>
    </div>
</section>

<style>
    .scrollbar-hide::-webkit-scrollbar {
        display: none;
    }
    .scrollbar-hide {
        -ms-overflow-style: none;
        scrollbar-width: none;
    }
</style>
