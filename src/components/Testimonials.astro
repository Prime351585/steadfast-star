---
const testimonials = [
    {
        quote: "Working with this agency was a game-changer for our business. Their attention to detail and creative approach exceeded our expectations.",
        author: "Sarah Johnson",
        role: "CEO, TechStart",
        image: "https://images.unsplash.com/photo-1494790108377-be9c29b29330?ixlib=rb-4.0.3&auto=format&fit=crop&w=100&q=80",
    },
    {
        quote: "The team is incredibly talented and professional. They delivered a beautiful website that perfectly represents our brand.",
        author: "Michael Chen",
        role: "Founder, GreenLife",
        image: "https://images.unsplash.com/photo-1472099645785-5658abf4ff4e?ixlib=rb-4.0.3&auto=format&fit=crop&w=100&q=80",
    },
    {
        quote: "I highly recommend their services. They are responsive, knowledgeable, and truly care about their clients' success.",
        author: "Emily Davis",
        role: "Marketing Director, Solstice",
        image: "https://images.unsplash.com/photo-1438761681033-6461ffad8d80?ixlib=rb-4.0.3&auto=format&fit=crop&w=100&q=80",
    },
];
---

<section class="py-24 bg-white">
    <div class="container mx-auto px-6">
        <div class="text-center max-w-3xl mx-auto mb-16">
            <h2
                class="text-sm font-bold text-primary tracking-widest uppercase mb-3"
            >
                Testimonials
            </h2>
            <h3 class="text-4xl md:text-5xl font-bold text-neutral-900">
                What Our Clients Say
            </h3>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
            {
                testimonials.map((t) => (
                    <div class="p-8 rounded-3xl bg-neutral-50 border border-neutral-100">
                        <div class="flex text-primary mb-6">
                            {[...Array(5)].map(() => (
                                <svg
                                    class="w-5 h-5"
                                    fill="currentColor"
                                    viewBox="0 0 20 20"
                                >
                                    <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z" />
                                </svg>
                            ))}
                        </div>
                        <p class="text-neutral-600 mb-6 italic">"{t.quote}"</p>
                        <div class="flex items-center gap-4">
                            <img
                                src={t.image}
                                alt={t.author}
                                class="w-12 h-12 rounded-full object-cover"
                            />
                            <div>
                                <div class="font-bold text-neutral-900">
                                    {t.author}
                                </div>
                                <div class="text-sm text-neutral-500">
                                    {t.role}
                                </div>
                            </div>
                        </div>
                    </div>
                ))
            }
        </div>
    </div>
</section>
