---
const testimonials = [
    {
        name: "Anand Mishra",
        role: "Business Owner",
        quote: "After working with Craft Presence, our website traffic and leads both improved. The team explained everything clearly and focused on results, not just reports.",
        stat: "42% increase in traffic",
    },
    {
        name: "Rahul Nagar",
        role: "Client",
        quote: "Craft Presence helped us get better visibility on Google and more genuine enquiries. Their support and communication were consistent throughout the project.",
        stat: "58% growth in enquiries",
    },
    {
        name: "Akshay",
        role: "Marketing Manager",
        quote: "We saw a clear improvement in lead quality after starting SEO and ads with Craft Presence. The strategies were practical and suited to our business.",
        stat: "35% better lead quality",
    },
    {
        name: "Mansi Awasthi",
        role: "Founder",
        quote: "Before working with Craft Presence, our online marketing had no direction. Now we have better traffic, better leads, and proper tracking.",
        stat: "3x better tracking",
    },
];
---

<section id="testimonials" class="py-24 bg-neutral-50 text-neutral-900">
    <div class="container mx-auto px-6">
        <div class="text-center max-w-3xl mx-auto mb-16">
            <h2
                class="text-sm font-bold text-primary tracking-widest uppercase mb-3"
            >
                Testimonials
            </h2>
            <h3 class="text-4xl md:text-5xl font-bold mb-6">
                Client Experiences with Craft Presence
            </h3>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
            {
                testimonials.map((t) => (
                    <div class="p-8 rounded-3xl bg-white border border-neutral-100 shadow-sm">
                        <div class="mb-6">
                            <span class="inline-block px-3 py-1 rounded-full bg-green-100 text-green-700 text-xs font-bold uppercase tracking-wide">
                                {t.stat}
                            </span>
                        </div>
                        <p class="text-lg text-neutral-600 mb-6 italic">
                            "{t.quote}"
                        </p>
                        <div class="flex items-center gap-4">
                            <div class="w-10 h-10 rounded-full bg-neutral-200 flex items-center justify-center font-bold text-neutral-500">
                                {t.name[0]}
                            </div>
                            <div>
                                <h4 class="font-bold text-neutral-900">
                                    {t.name}
                                </h4>
                                <p class="text-sm text-neutral-500">{t.role}</p>
                            </div>
                        </div>
                    </div>
                ))
            }
        </div>

        <!-- Trustpilot Section -->
        <div class="mt-16 text-center border-t border-neutral-200 pt-10">
            <div
                class="inline-flex items-center gap-2 px-6 py-3 rounded-xl bg-white border border-neutral-200 shadow-sm"
            >
                <span class="font-bold text-lg">Excellent</span>
                <span class="flex gap-0.5 text-green-500">
                    <svg class="w-6 h-6 fill-current" viewBox="0 0 24 24"
                        ><path
                            d="M12 17.27L18.18 21l-1.64-7.03L22 9.24l-7.19-.61L12 2 9.19 8.63 2 9.24l5.46 4.73L5.82 21z"
                        ></path></svg
                    >
                    <svg class="w-6 h-6 fill-current" viewBox="0 0 24 24"
                        ><path
                            d="M12 17.27L18.18 21l-1.64-7.03L22 9.24l-7.19-.61L12 2 9.19 8.63 2 9.24l5.46 4.73L5.82 21z"
                        ></path></svg
                    >
                    <svg class="w-6 h-6 fill-current" viewBox="0 0 24 24"
                        ><path
                            d="M12 17.27L18.18 21l-1.64-7.03L22 9.24l-7.19-.61L12 2 9.19 8.63 2 9.24l5.46 4.73L5.82 21z"
                        ></path></svg
                    >
                    <svg class="w-6 h-6 fill-current" viewBox="0 0 24 24"
                        ><path
                            d="M12 17.27L18.18 21l-1.64-7.03L22 9.24l-7.19-.61L12 2 9.19 8.63 2 9.24l5.46 4.73L5.82 21z"
                        ></path></svg
                    >
                    <svg class="w-6 h-6 fill-current" viewBox="0 0 24 24"
                        ><path
                            d="M12 17.27L18.18 21l-1.64-7.03L22 9.24l-7.19-.61L12 2 9.19 8.63 2 9.24l5.46 4.73L5.82 21z"
                        ></path></svg
                    >
                </span>
                <span class="font-bold">4.7 out of 5</span>
                <span class="text-neutral-400 text-sm ml-2">Trustpilot</span>
            </div>
        </div>
    </div>
</section>
