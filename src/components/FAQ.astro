---
import type { HomepageContent } from "../data/homepage/types";

interface Props {
	content: HomepageContent["faq"];
}

const { content } = Astro.props;
---

<section class="py-24 bg-white text-neutral-900">
    <div class="container mx-auto px-6 content-width">
        <div class="text-center mb-16">
            <h2 class="text-3xl md:text-5xl font-bold mb-6">
                {content.title}
            </h2>
            <p class="text-neutral-600">{content.subtitle}</p>
        </div>

        <div class="space-y-4">
            {
                content.items.map((faq) => (
                    <details class="group border border-neutral-200 rounded-2xl bg-white [&_summary::-webkit-details-marker]:hidden">
                        <summary class="flex items-center justify-between font-bold cursor-pointer p-6 text-xl text-neutral-900 outline-none">
                            <span>{faq.question}</span>
                            <span class="transition duration-300 group-open:-rotate-180 shrink-0 ml-4 text-primary">
                                <svg fill="none" height="24" shape-rendering="geometricPrecision" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" viewBox="0 0 24 24" width="24"><path d="M6 9l6 6 6-6"></path></svg>
                            </span>
                        </summary>
                        <div class="text-neutral-600 leading-relaxed px-6 pb-6 -mt-2">
                            <p>{faq.answer}</p>
                        </div>
                    </details>
                ))
            }
        </div>
    </div>
</section>
