---
const plans = [
    {
        name: "Starter",
        price: "$2,500",
        features: [
            "Custom Design",
            "5 Pages",
            "Mobile Responsive",
            "SEO Basics",
            "1 Month Support",
        ],
        featured: false,
    },
    {
        name: "Professional",
        price: "$5,000",
        features: [
            "Premium Design",
            "10 Pages",
            "CMS Integration",
            "Advanced SEO",
            "Performance Optimization",
            "3 Months Support",
        ],
        featured: true,
    },
    {
        name: "Enterprise",
        price: "Custom",
        features: [
            "Full-Scale Solution",
            "Unlimited Pages",
            "Custom Functionality",
            "Priority Support",
            "Dedicated Manager",
        ],
        featured: false,
    },
];
---

<section id="pricing" class="py-24 bg-neutral-50">
    <div class="container mx-auto px-6">
        <div class="text-center max-w-3xl mx-auto mb-16">
            <h2
                class="text-sm font-bold text-primary tracking-widest uppercase mb-3"
            >
                Pricing
            </h2>
            <h3 class="text-4xl md:text-5xl font-bold text-neutral-900 mb-6">
                Transparent Pricing
            </h3>
            <p class="text-neutral-600 text-lg">
                Choose the plan that fits your needs. No hidden fees.
            </p>
        </div>

        <div
            class="grid grid-cols-1 md:grid-cols-3 gap-8 max-w-6xl mx-auto items-center"
        >
            {
                plans.map((plan) => (
                    <div
                        class={`relative p-8 rounded-3xl border transition-all duration-300 ${plan.featured ? "bg-neutral-900 text-white border-neutral-900 scale-105 shadow-2xl z-10" : "bg-white text-neutral-900 border-neutral-200 hover:border-primary/50"}`}
                    >
                        {plan.featured && (
                            <div class="absolute top-0 left-1/2 -translate-x-1/2 -translate-y-1/2 px-4 py-1 bg-primary text-white text-xs font-bold uppercase tracking-wider rounded-full">
                                Most Popular
                            </div>
                        )}
                        <h4 class="text-2xl font-bold mb-2">{plan.name}</h4>
                        <div class="text-4xl font-bold mb-6">{plan.price}</div>
                        <ul class="space-y-4 mb-8">
                            {plan.features.map((feature) => (
                                <li class="flex items-center gap-3">
                                    <svg
                                        class={`w-5 h-5 ${plan.featured ? "text-primary" : "text-primary"}`}
                                        fill="none"
                                        stroke="currentColor"
                                        viewBox="0 0 24 24"
                                    >
                                        <path
                                            stroke-linecap="round"
                                            stroke-linejoin="round"
                                            stroke-width="2"
                                            d="M5 13l4 4L19 7"
                                        />
                                    </svg>
                                    <span
                                        class={
                                            plan.featured
                                                ? "text-neutral-300"
                                                : "text-neutral-600"
                                        }
                                    >
                                        {feature}
                                    </span>
                                </li>
                            ))}
                        </ul>
                        <a
                            href="#contact"
                            class={`block w-full py-4 rounded-xl font-semibold text-center transition-colors ${plan.featured ? "bg-primary text-white hover:bg-primary-600" : "bg-neutral-100 text-neutral-900 hover:bg-neutral-200"}`}
                        >
                            Get Started
                        </a>
                    </div>
                ))
            }
        </div>
    </div>
</section>
