---
import type { HomepageContent } from "../data/homepage/types";

interface Props {
	content: HomepageContent["keyReasons"];
}

const { content } = Astro.props;
---

<section class="py-24 bg-neutral-50 text-neutral-900">
    <div class="container mx-auto px-6">
        <div class="content-width mx-auto mb-16 text-center">
            <h2 class="text-3xl md:text-5xl font-bold mb-6">
                {content.title}
            </h2>
            <p class="text-lg text-neutral-600 whitespace-pre-line">
                {content.intro}
            </p>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
            {
                content.reasons.map((reason, index) => (
                    <div class="bg-white p-8 rounded-2xl shadow-sm border border-neutral-100">
                        <div class="text-primary font-bold text-xl mb-4">
                            0{index + 1}
                        </div>
                        <h3 class="text-xl font-bold mb-3">{reason.title}</h3>
                        <p class="text-neutral-600 leading-relaxed text-sm">
                            {reason.description}
                        </p>
                    </div>
                ))
            }
        </div>
    </div>
</section>
